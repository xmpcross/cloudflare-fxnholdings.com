---
import PlatformLandscape from '@/components/about/PlatformLandscape.astro';
import BrandOrbit from '@/components/about/BrandOrbit.astro';
import BusinessDetails from '@/components/BusinessDetails.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import Icon from '@/components/ui/Icon.astro';
import Stats from '@/components/home/Stats.astro';
import {venture,facts} from '@/config/fxn';
---
<BaseLayout title="About FXN Holdings" description="Learn about the UK and Australian businesses behind FXN Holdings and the websites, applications and digital platforms we manage.">
<section class="pt-14 pb-16 sm:pt-20 sm:pb-24"><div class="shell"><div class="grid gap-8 lg:grid-cols-12 lg:items-end"><div class="lg:col-span-8"><p class="eyebrow bg-blue-soft text-blue-ink"><Icon name="building" class="size-4" />About FXN Holdings</p><h1 class="mt-6 max-w-4xl text-display-xl">Always exploring.<br />Always building.</h1></div><p class="text-lead text-muted lg:col-span-4">FXN Holdings brings together businesses in the United Kingdom and Australia under common ownership. We build and manage digital platforms that help people discover information, compare options and shop online.</p></div><BrandOrbit /></div></section>
<section class="ruled section"><div class="shell about-split"><PlatformLandscape /><div class="about-copy"><SectionHead eyebrow={{label:'Our story',icon:'route',tone:'blue'}} title="One project taught us how to build the next." size="md" /><p class="mt-6 text-lead text-muted">FXN Holdings began with a single website. Each launch taught us more about the tools, content and experiences that make a platform useful.</p><p class="mt-5 text-muted">Today we manage websites across commerce, travel, publishing, price comparison and online tools. Each has its own audience, supported by the experience gained across our businesses.</p><a class="arrow-link mt-7 inline-flex items-center gap-2" href="/portfolio/">Explore our managed platforms <Icon name="arrow-right" class="size-4" /></a></div></div></section>
<Stats items={facts} />
<section class="ruled section"><div class="shell"><SectionHead eyebrow={{label:'Our principles',icon:'target',tone:'blue'}} title="Four ideas behind every platform." /><div class="principles mt-12">{venture.principles.map(p=><article><span class="grid size-10 place-items-center rounded-[8px] bg-blue-soft text-blue-ink"><Icon name={p.icon} class="size-5" /></span><h3 class="mt-9 text-title">{p.title}</h3><p class="mt-3 text-muted">{p.body}</p></article>)}</div></div></section>
<section class="ruled section"><div class="shell about-split process-split"><div class="about-copy"><SectionHead eyebrow={{label:'Our operating model',icon:'route',tone:'orange'}} title="From an idea to everyday use." size="md" /><ol class="journey mt-8">{venture.process.map((p,i)=><li><span class="step-index">0{i+1}</span><div><h3 class="font-semibold">{p.title}</h3><p class="mt-2 text-sm text-muted">{p.body}</p></div></li>)}</ol></div><figure class="lifecycle"><svg viewBox="0 0 500 460" role="img" aria-labelledby="cycle-title cycle-desc"><title id="cycle-title">A continuous cycle of platform improvement</title><desc id="cycle-desc">Explore, build, launch and improve form a circle around each platform, showing that management continues after launch.</desc><circle cx="250" cy="222" r="142" fill="none" stroke="#d2deee" stroke-width="2"/><path d="m378 156 6 14 11-11M147 326l-15-2 2 15M154 115l15-3-8-12" fill="none" stroke="#0062de" stroke-width="2"/><circle cx="250" cy="222" r="75" fill="white" stroke="#dbe4ef"/><image href="/fxn-holdings-logo.svg" x="200" y="194" width="100" height="45"/><text x="250" y="257" text-anchor="middle" fill="#69778c" font-size="10">Every platform</text>{[{x:250,y:80,label:'Explore',number:'01'},{x:392,y:222,label:'Build',number:'02'},{x:250,y:364,label:'Launch',number:'03'},{x:108,y:222,label:'Improve',number:'04'}].map(n=><g><rect x={n.x-51} y={n.y-33} width="102" height="66" rx="12" fill="white" stroke="#dbe4ef"/><text x={n.x} y={n.y-7} text-anchor="middle" font-size="10" fill="#0062de">{n.number}</text><text x={n.x} y={n.y+15} text-anchor="middle" font-size="14" fill="#2d2d2d" font-weight="500">{n.label}</text></g>)}</svg><figcaption>Launch is a milestone. Improvement continues.</figcaption></figure></div></section>
<section class="ruled section bg-wash" id="businesses"><div class="shell"><SectionHead eyebrow={{label:'Business information',icon:'globe',tone:'blue'}} title="One shared brand. UK and Australian businesses." /><div class="mt-10"><BusinessDetails /></div><p class="mt-6 text-muted">For a particular platform, purchase or commercial agreement, refer to the business named in its terms or contract. Our shared brand does not change the responsible legal party.</p></div></section>

</BaseLayout>
<style>

.about-split{display:grid;gap:2.5rem;align-items:center}.about-copy{max-width:36rem}.principles{display:grid;gap:1px;background:var(--line);border:1px solid var(--line);border-radius: 8px;overflow:hidden}.principles article{background:var(--surface);padding:2rem}.journey{display:grid;gap:1.5rem}.journey li{display:flex;gap:1.25rem;align-items:flex-start}.step-index{font-size:.75rem;color:var(--blue);padding-top:.25rem;font-variant-numeric:tabular-nums}.lifecycle{background:#f8fafc;border:1px solid var(--line);border-radius: 8px;padding:1.5rem;min-width:0}.lifecycle svg{display:block;width:100%;height:auto;max-width:500px;margin:auto}.lifecycle figcaption{text-align:center;color:var(--muted);font-size:.8rem;padding:.5rem 0 1rem}
@media(min-width:40rem){.principles{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(min-width:64rem){.about-split{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:4rem}.principles{grid-template-columns:repeat(4,minmax(0,1fr))}.process-split{gap:5rem}}@media(max-width:639px){.lifecycle{padding:.75rem}.lifecycle figcaption{font-size:.75rem}}
</style>
