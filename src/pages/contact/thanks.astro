---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Thank you for your message" description="Your enquiry has been sent to the FXN Holdings team.">
  <section class="shell section">
    <h1 class="max-w-3xl">Thank you for getting in touch.</h1>
    <p class="mt-6 text-lead text-muted">Your message has been sent to the FXN team.</p>
    <a href="/" class="btn btn-primary mt-8">Return to the homepage</a>
  </section>
</BaseLayout>
