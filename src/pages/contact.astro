---
import BusinessDetails from '@/components/BusinessDetails.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
const topics=['Explore a partnership','Discuss a supplier or brand','Talk about advertising','Share a platform opportunity','Ask a general question'];
const routes=[{title:'Partnerships',body:'Affiliate networks, commercial collaborations and opportunities to work together.',icon:'handshake'},{title:'Suppliers & brands',body:'Products, catalogues and services that fit the audiences of our platforms.',icon:'shopping-cart'},{title:'Advertising',body:'Relevant placements and commercial opportunities across our managed platforms.',icon:'megaphone'},{title:'New opportunities',body:'A market gap, a useful idea or a platform you would like us to explore.',icon:'sparkles'}];
---
<BaseLayout title="Contact FXN Holdings" description="Talk to the FXN Holdings team about partnerships, suppliers, advertising and new platform opportunities.">
<section class="pt-14 pb-16 sm:pt-20 sm:pb-24"><div class="shell grid gap-12 lg:grid-cols-12 lg:gap-10"><div class="lg:col-span-5"><p class="eyebrow bg-blue-soft text-blue-ink"><Icon name="message-square" class="size-4" />Contact</p><h1 class="mt-6 text-display-xl">Let's talk about what comes next.</h1><p class="mt-6 text-lead text-muted">Have a product, a partnership or a market worth exploring? Tell us what you have in mind and how we can help.</p><ol class="mt-10 grid gap-5">{['Tell us about the opportunity and who it serves.','Include the platform and UK or Australian business your enquiry relates to, if known.','Let us know the best way to get back to you.'].map((x,i)=><li class="flex items-start gap-4 text-ink-soft"><span class="grid size-8 shrink-0 place-items-center rounded-[8px] bg-blue-soft text-sm font-semibold text-blue-ink">{i+1}</span><span>{x}</span></li>)}</ol><a class="mt-8 inline-block break-all text-blue-ink underline underline-offset-4" href="mailto:contact@fxnholdings.com">contact@fxnholdings.com</a></div><div class="lg:col-span-7 xl:col-span-6 xl:col-start-7"><form id="contact-form" class="contact-card" action="/api/contact" method="post"><div class="contact-honeypot" aria-hidden="true"><label for="bot-field">Leave this field empty</label><input id="bot-field" name="bot-field" tabindex="-1" autocomplete="off" /></div><div><label for="reason" class="text-title">I’d like to</label><select id="reason" name="subject" class="topic-select mt-3">{topics.map(t=><option>{t}</option>)}</select></div><div class="grid gap-5 sm:grid-cols-2"><div><label for="name">Name <span aria-hidden="true">*</span></label><input id="name" name="name" autocomplete="name" maxlength="200" required /></div><div><label for="email">Email <span aria-hidden="true">*</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="200" required /></div><div><label for="company">Company</label><input id="company" name="company" autocomplete="organization" maxlength="200" /></div><div><label for="website">Website</label><input id="website" name="website" type="url" placeholder="https://" maxlength="500" /></div></div><div><label for="message">What would you like to explore? <span aria-hidden="true">*</span></label><textarea id="message" name="body" rows="6" maxlength="5000" placeholder="Tell us about your idea, product or proposal." required></textarea></div><div class="border-t border-line pt-6"><button type="submit" class="btn btn-primary"><span data-submit-label>Send message</span> <Icon name="arrow-right" class="size-4" /></button><p class="mt-4 text-sm text-muted">Your enquiry will be sent directly to the FXN team.</p><p id="contact-status" class="mt-3 text-sm text-muted" role="status" aria-live="polite" tabindex="-1"></p></div><p class="text-xs text-muted">Read our <a href="/privacy/" class="underline">Privacy Policy</a> for how enquiries are handled.</p></form></div></div></section>
<section class="ruled section"><div class="shell"><SectionHead title="A few good reasons to get in touch." lead="Every enquiry comes to the FXN team. Choose the subject that best fits what you have in mind." /><div class="contact-routes mt-10">{routes.map(r=><article><span class="grid size-10 place-items-center rounded-[8px] bg-blue-soft text-blue-ink"><Icon name={r.icon} class="size-5" /></span><h3 class="mt-8 text-title">{r.title}</h3><p class="mt-3 text-muted">{r.body}</p><a class="arrow-link mt-6 inline-flex" href={'mailto:contact@fxnholdings.com?subject='+encodeURIComponent(r.title)}>Email the team <Icon name="arrow-up-right" class="size-4" /></a></article>)}</div></div></section>
<section class="ruled section" id="business-details"><div class="shell"><SectionHead title="Our UK and Australian business details." lead="For correspondence, use the details of the business your enquiry concerns. You can reach either business through contact@fxnholdings.com." /><div class="mt-10"><BusinessDetails /></div></div></section>
</BaseLayout>
<script>
const form = document.querySelector<HTMLFormElement>('#contact-form');
form?.addEventListener('submit', async (event) => {
  event.preventDefault();
  if (!form.reportValidity() || form.getAttribute('aria-busy') === 'true') return;
  const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
  const label = button.querySelector<HTMLElement>('[data-submit-label]')!;
  const status = document.querySelector<HTMLElement>('#contact-status')!;
  form.setAttribute('aria-busy', 'true');
  button.disabled = true;
  label.textContent = 'Sending…';
  status.textContent = '';
  try {
    const response = await fetch(form.action, {
      method: 'POST',
      headers: { Accept: 'application/json' },
      body: new FormData(form),
    });
    const result = await response.json();
    if (!response.ok || result.ok !== true) {
      status.textContent = result.error || 'Your message could not be sent. Please try again.';
    } else {
      form.reset();
      status.textContent = 'Thank you. Your message has been sent to the FXN team.';
    }
  } catch {
    status.textContent = 'We could not confirm delivery. Please check your connection before trying again, or email contact@fxnholdings.com.';
  } finally {
    form.removeAttribute('aria-busy');
    button.disabled = false;
    label.textContent = 'Send message';
    status.focus();
  }
});
</script>
<style>
.contact-honeypot{position:absolute;left:-10000px;width:1px;height:1px;overflow:hidden}button:disabled{opacity:.65;cursor:wait}

.contact-card{display:grid;gap:1.5rem;padding:1.5rem;border:1px solid var(--line);border-radius: 8px;background:var(--surface);box-shadow:var(--shadow-float)}label{display:block;font-size:.875rem;font-weight:500;margin-bottom:.5rem}input,textarea,select{width:100%;min-width:0;padding:.75rem .9rem;border:1px solid var(--line-strong);border-radius: 8px;background:var(--surface);font:inherit;font-size:.9375rem}input:focus,textarea:focus,select:focus{outline:2px solid var(--blue);outline-offset:2px}textarea{resize:vertical}.topic-select{background:var(--blue-soft);color:var(--blue-ink);font-weight:500}.contact-routes,.locations{display:grid;gap:1rem}.contact-routes article{border:1px solid var(--line);padding:1.5rem;border-radius: 8px}.locations{gap:0;border:1px solid var(--line);border-radius: 8px;overflow:hidden}.locations article{padding:2rem;background:var(--wash)}@media(min-width:40rem){.contact-card{padding:2.25rem}.contact-routes{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(min-width:64rem){.contact-routes{grid-template-columns:repeat(4,minmax(0,1fr))}.locations{grid-template-columns:repeat(3,minmax(0,1fr))}}
</style>
