---
import BaseLayout from '@/layouts/BaseLayout.astro';
import pages from '@/data/pages.json';
import {getPosts,postHref} from '@/lib/posts';
const posts=await getPosts();
---
<BaseLayout title="Sitemap"><section class="shell section"><h1 class="text-display-lg">Everything in one place.</h1><div class="mt-12 grid gap-12 md:grid-cols-2"><div><h2 class="text-title">Company</h2><ul class="mt-5 space-y-3">{pages.map(p=><li><a class="arrow-link" href={p.path}>{p.heading}</a></li>)}</ul></div><div><h2 class="text-title">Insights</h2><ul class="mt-5 space-y-3">{posts.map(p=><li><a class="arrow-link" href={postHref(p)}>{p.data.title}</a></li>)}</ul></div></div></section></BaseLayout>
