---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import technologyLogos from '@/data/technologies.json';
import platforms from '@/data/portfolio.json';
const groups=[
 {title:'Web experiences',body:'Frameworks for content-rich websites, responsive interfaces and useful browser tools.',names:['Next.js','React','Astro','Tailwind CSS']},
 {title:'Content & commerce',body:'Publishing systems and store platforms selected for each website’s audience and purpose.',names:['Payload CMS','Strapi','WordPress','WooCommerce']},
 {title:'Automation & delivery',body:'Tools for connecting workflows, packaging applications and delivering websites.',names:['n8n','Docker','Cloudflare','Vercel']}
];
const layers=[{title:'The experience',detail:'Websites · Applications · Stores',icon:'globe'},{title:'The foundations',detail:'Content · Product data · Search',icon:'blocks'},{title:'The connections',detail:'Workflows · Hosting · Deployment',icon:'code'}];
---
<BaseLayout title="Technology & AI" description="Explore the web frameworks, content systems, commerce platforms and automation tools behind FXN Holdings’ managed websites, plus our approach to AI.">
<section class="shell tech-hero"><div><p class="eyebrow bg-blue-soft text-blue-ink"><Icon name="code" class="size-4" />Technology &amp; AI</p><h1 class="mt-6">Shared foundations.<br />Individual platforms.</h1><p class="mt-7 text-lead text-muted">We connect content, data and modern web technology to build and manage useful digital platforms. Each website keeps its own identity, with tools chosen for the job.</p><nav class="mt-8 flex flex-wrap gap-3" aria-label="Technology page sections"><a class="btn btn-primary" href="#stack">Explore our stack</a><a class="btn btn-secondary" href="#ai">Our approach to AI</a></nav></div><figure class="stack-visual"><div class="stack-top"><span>From foundation to experience</span><Icon name="blocks" class="size-5 text-blue-ink" /></div>{layers.map((layer,i)=><div class:list={['stack-layer',`layer-${i}`]}><span class="stack-icon"><Icon name={layer.icon} class="size-6" /></span><div><h2>{layer.title}</h2><p>{layer.detail}</p></div><span class="layer-number">0{i+1}</span></div>)}<figcaption>Connected systems. A distinct experience for every audience.</figcaption></figure></section>
<section class="ruled section" id="stack"><div class="shell"><SectionHead title="The tools behind our platforms." lead="We use open-source frameworks alongside established content, commerce and cloud services. The combination varies by website; these are tools used across our projects." /><div class="tech-groups mt-12">{groups.map(group=><article><h3 class="text-title">{group.title}</h3><p class="mt-3 text-muted">{group.body}</p><ul class="tool-list mt-7">{group.names.map(name=>{const logo=technologyLogos.find(l=>l.name===name)!;return <li><img src={logo.src} width="25" height="25" alt="" loading="lazy"/><span>{name}</span></li>})}</ul></article>)}</div></div></section>
<section class="ruled section"><div class="shell architecture-layout"><div><SectionHead title="How content reaches our websites." size="md" lead="Shared services support our content and comparison websites. Articles, product details and offers move through a common foundation before reaching each site." /><p class="mt-6 text-muted">Reusable components reduce repeated work. Separate releases let us update each website for its audience, while shared improvements can benefit several platforms.</p><p class="mt-5 text-muted">Our stores use commerce systems suited to their catalogues, including WooCommerce and hosted platforms such as FreshStore.</p></div><ol class="flow">{[{title:'Sources & partners',body:'Articles, retailer feeds, offers and product information.',icon:'globe'},{title:'Content & data services',body:'Content management, catalogue organisation and product search.',icon:'blocks'},{title:'Individual websites',body:'Interfaces and releases tailored to each platform.',icon:'code'},{title:'Readers & customers',body:'Information, comparisons and tools ready to use.',icon:'user-check'}].map((step,i)=><li><span class="flow-node"><Icon name={step.icon} class="size-5" /></span><div><p class="text-xs text-muted">0{i+1}</p><h3 class="mt-1 font-semibold">{step.title}</h3><p class="mt-2 text-sm text-muted">{step.body}</p></div></li>)}</ol></div></section>
<section class="ruled section bg-wash" id="by-website"><div class="shell"><SectionHead title="A closer look at each platform." lead="A practical view of the technology behind the websites and tools we manage. Similar foundations support different audiences and experiences." /><div class="platform-stack mt-10">{platforms.map(p=><article><div><h3><a href={p.href}>{p.name} <span aria-hidden="true">↗</span></a></h3><p class="mt-2 text-xs text-muted">{p.category}</p></div><ul aria-label={'Technology used by '+p.name}>{p.platforms.map(t=><li>{t}</li>)}</ul></article>)}</div></div></section>
<section class="ruled section ai-panel" id="ai"><div class="shell architecture-layout"><div><p class="eyebrow bg-blue-soft text-blue-ink"><Icon name="sparkles" class="size-4" />AI with human review</p><h2 class="mt-6 text-display-md">Technology assists.<br />People decide.</h2><p class="mt-6 text-lead">AI supports research, drafts and content enrichment, including product titles and descriptions. A person reviews AI-assisted content before it is published.</p><p class="mt-5">Clear accountability, privacy and appropriate rules guide our approach. Automation supports the work; editorial decisions stay with people.</p><a class="btn btn-light mt-8" href="/insights/how-we-use-ai/">Read how we use AI <Icon name="arrow-right" class="size-4" /></a></div><div class="review-workflow"><p class="workflow-label">The publishing checkpoint</p>{[{title:'Prepare a draft',body:'Research and AI assistance bring a first version together.',icon:'file-text'},{title:'Review and refine',body:'A person checks claims, context, relevance and clarity.',icon:'user-check'},{title:'Publish',body:'Reviewed content reaches the relevant platform.',icon:'newspaper'}].map((s,i)=><div class:list={['review-stage',i===1&&'human-stage']}><Icon name={s.icon} class="size-6" /><div><h3>{s.title}</h3><p>{s.body}</p></div></div>)}</div></div></section>
<section class="ruled section"><div class="shell"><SectionHead title="Built to keep improving." lead="Our engineering choices support the everyday work of maintaining websites, publishing useful content and adapting to new requirements." /><div class="practice-grid mt-10">{[{title:'Independent releases',body:'Update sites separately to reduce the impact of individual changes.',icon:'blocks'},{title:'Readable pages',body:'Use server-rendered content where appropriate so readers and search engines can access it.',icon:'file-text'},{title:'Reusable foundations',body:'Carry proven components and workflows forward into the next improvement.',icon:'code'}].map(p=><article><Icon name={p.icon} class="size-6 text-blue-ink" /><h3 class="mt-5 text-title">{p.title}</h3><p class="mt-3 text-muted">{p.body}</p></article>)}</div></div></section>
</BaseLayout>
<style>
h1{font-size:4rem;line-height:1.05;letter-spacing:-.05em;overflow-wrap:normal}.tech-hero{display:grid;gap:3rem;align-items:center;padding-block:4rem 5rem}.stack-visual{background:#f5f8fd;border:1px solid var(--line);border-radius:1.5rem;padding:1.5rem;min-width:0}.stack-top{display:flex;justify-content:space-between;align-items:center;font-size:.8rem;color:var(--muted);margin-bottom:2rem}.stack-layer{display:flex;gap:1rem;align-items:center;padding:1.5rem 1.25rem;background:white;border:1px solid var(--line);border-radius:.85rem;position:relative}.stack-layer+.stack-layer{margin-top:1rem}.stack-layer+.stack-layer:before{content:'';position:absolute;height:1rem;width:1px;left:2.5rem;bottom:100%;background:#a9bedb}.stack-layer h2{font-weight:600;font-size:1rem}.stack-layer p{font-size:.75rem;color:var(--muted);margin-top:.4rem}.stack-icon{display:grid;place-items:center;width:3rem;height:3rem;border-radius:.7rem;background:var(--blue-soft);color:var(--blue);flex-shrink:0}.layer-1 .stack-icon{background:#fff0ed;color:#b93630}.layer-number{margin-left:auto;font-size:.65rem;color:var(--muted)}figcaption{font-size:.75rem;color:var(--muted);margin-top:1.5rem;text-align:center}.tech-groups,.practice-grid{display:grid;gap:2rem}.tech-groups>article{padding-top:1.5rem;border-top:2px solid var(--line)}.tool-list{display:grid;gap:.75rem}.tool-list li{display:flex;align-items:center;gap:1rem;padding:.9rem 1rem;border:1px solid var(--line);border-radius:.65rem}.tool-list img{object-fit:contain}.architecture-layout{display:grid;gap:3rem;align-items:center}.architecture-layout>div{min-width:0}.flow{padding:2rem;background:#f5f8fd;border:1px solid var(--line);border-radius:1.5rem}.flow li{display:flex;gap:1.25rem;position:relative;padding-bottom:2rem}.flow li:last-child{padding-bottom:0}.flow li:not(:last-child):before{content:'';position:absolute;top:2.5rem;bottom:0;left:1.25rem;width:1px;background:#c9d8eb}.flow-node{display:grid;place-items:center;width:2.5rem;height:2.5rem;background:white;border:1px solid var(--line);border-radius:50%;color:var(--blue);flex-shrink:0}.platform-stack{border-top:1px solid var(--line)}.platform-stack article{display:grid;gap:1rem;padding:1.5rem 0;border-bottom:1px solid var(--line)}.platform-stack h3{font-weight:600;overflow-wrap:anywhere}.platform-stack h3 span{font-size:.75rem;color:var(--blue)}.platform-stack ul{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem}.platform-stack li{font-size:.75rem;border:1px solid var(--line);background:white;padding:.4rem .65rem;border-radius:.4rem}.ai-panel{background:var(--night);color:var(--night-ink)}.ai-panel p{color:var(--night-muted)}.ai-panel .eyebrow{color:var(--blue-ink)}.review-workflow{border:1px solid var(--night-line);border-radius:1.5rem;padding:1.5rem;background:var(--night-raised)}.workflow-label{font-size:.75rem;margin-bottom:1.5rem}.review-stage{display:flex;gap:1rem;padding:1.5rem 1rem;align-items:center}.review-stage>svg{flex-shrink:0}.review-stage h3{font-weight:600}.review-stage p{font-size:.8rem;margin-top:.4rem}.human-stage{background:#0062de26;border:1px solid #639ffb66;border-radius:.8rem}.practice-grid article{border-left:1px solid var(--line);padding-left:1.5rem}
@media(min-width:64rem){.tech-hero,.architecture-layout{grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:4rem}.tech-groups,.practice-grid{grid-template-columns:repeat(3,minmax(0,1fr))}.stack-visual{padding:2rem}.platform-stack article{grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);align-items:center}}@media(max-width:639px){h1{font-size:clamp(2.65rem,10vw,4rem)}.stack-visual{padding:1rem}.stack-layer{padding:1rem;gap:.75rem}.layer-number{display:none}.flow{padding:1.25rem}}
</style>
