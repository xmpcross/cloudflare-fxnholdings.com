---
import BaseLayout from '@/layouts/BaseLayout.astro';
import portfolio from '@/data/portfolio.json';
const groups=[{id:'ecommerce',title:'E-commerce',prefix:'E-commerce'},{id:'travel',title:'Travel & booking',prefix:'Travel'},{id:'content',title:'Content & publishing',prefix:'Content'},{id:'comparison',title:'Price comparison & deals',prefix:'Price'},{id:'tools',title:'Free online tools',prefix:'Free'}];
---
<BaseLayout title="Managed websites and digital platforms" description="Browse the 14 websites and tools managed under the FXN Holdings brand, covering commerce, travel, publishing and comparison.">
<header class="shell py-16 sm:py-24"><h1 class="max-w-3xl text-display-xl">Websites and platforms<br />we manage.</h1><p class="mt-6 max-w-2xl text-lead text-muted">Meet the {portfolio.length} websites and tools we manage. Find out what each offers and visit the platform directly. Refer to each platform’s terms and legal information for its responsible business.</p><nav aria-label="Platform categories" class="mt-9 flex flex-wrap gap-3">{groups.map(g=><a class="btn btn-secondary btn-sm" href={'#'+g.id}>{g.title}</a>)}</nav></header>
{groups.map(g=><section id={g.id} class="ruled section"><div class="shell"><h2 class="text-display-md">{g.title}</h2><div class="mt-9 grid gap-5 md:grid-cols-2">{portfolio.filter(p=>p.category.startsWith(g.prefix)).map(p=><article class="min-w-0 rounded-2xl border border-line p-7"><p class="text-sm text-muted">{p.category}</p><h3 class="mt-2 break-words text-title"><a href={p.href}>{p.name}</a></h3><p class="mt-4 text-muted">{p.description}</p><a href={p.href} class="arrow-link mt-6 inline-flex">Visit website <span aria-hidden="true">↗</span></a></article>)}</div></div></section>)}

</BaseLayout>

<style>h1{font-size:4rem;}</style>
