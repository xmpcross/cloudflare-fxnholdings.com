---
import { pricing } from "@/config/pricing";

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<fieldset class:list={["billing flex w-fit rounded-[8px] bg-wash p-1 shadow-[inset_0_0_0_1px_var(--line)]", className]}>
  <legend class="sr-only">Billing period</legend>
  <label class="billing-option">
    <input type="radio" name="billing" value="monthly" class="sr-only" checked data-billing />
    <span>Monthly</span>
  </label>
  <label class="billing-option">
    <input type="radio" name="billing" value="annual" class="sr-only" data-billing />
    <span>Yearly <span class="billing-save">{pricing.annualSaving}</span></span>
  </label>
</fieldset>

<style>
  .billing-option > span {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 1rem;
    border-radius: 8px;
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--muted);
    cursor: pointer;
    transition:
      background-color 0.25s,
      color 0.25s,
      box-shadow 0.25s;
  }

  .billing-option > span:hover {
    color: var(--ink);
  }

  .billing-option .billing-save {
    padding: 0.05rem 0.45rem;
    border-radius: 8px;
    background: var(--green-soft);
    color: var(--green-ink);
    font-size: 0.8125rem;
  }

  .billing-option input:checked + span {
    background: var(--surface);
    color: var(--ink);
    box-shadow:
      0 1px 2px rgb(12 12 14 / 0.08),
      0 0 0 1px rgb(12 12 14 / 0.06);
  }

  .billing-option input:focus-visible + span {
    outline: 2px solid var(--blue);
    outline-offset: 2px;
  }
</style>

<script>
  /* Every price on the page carries both amounts; the toggle swaps them. */
  document.querySelectorAll<HTMLInputElement>("[data-billing]").forEach((input) =>
    input.addEventListener("change", () => {
      const period = input.value === "annual" ? "annual" : "monthly";
      document.querySelectorAll<HTMLElement>("[data-monthly]").forEach((price) => {
        price.textContent = price.dataset[period] ?? price.textContent;
      });
      document.querySelectorAll<HTMLElement>("[data-billed]").forEach((note) => {
        note.textContent = period === "annual" ? "per seat / month, billed yearly" : "per seat / month";
      });
    }),
  );
</script>
