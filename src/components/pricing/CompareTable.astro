---
import Icon from "@/components/ui/Icon.astro";
import { pricing, type Cell } from "@/config/pricing";
import { softTone } from "@/lib/tones";
import Price from "./Price.astro";

const { plans, groups } = pricing;
const featured = plans.find((plan) => plan.featured)?.id ?? plans[0].id;
const isFeatured = (id: string) => id === featured;
---

<div class="compare" data-compare>
  <div
    class="compare-switch sticky z-20 mb-3 grid gap-1 bg-wash md:hidden"
    style={`grid-template-columns: repeat(${plans.length}, minmax(0, 1fr))`}
    role="group"
    aria-label="Show plan"
  >
    {
      plans.map((plan) => (
        <button type="button" class="compare-tab" aria-pressed={isFeatured(plan.id) ? "true" : "false"} data-show={plan.id}>
          {plan.name}
        </button>
      ))
    }
  </div>

  <table class="w-full table-fixed border-separate border-spacing-0">
    <caption class="sr-only">{pricing.compareTitle}</caption>
    <colgroup>
      <col class="compare-feature-col" />
      {plans.map((plan) => <col data-col={plan.id} data-off={isFeatured(plan.id) ? undefined : ""} />)}
    </colgroup>
    <thead>
      <tr>
        <th scope="col" class="compare-head compare-lead align-bottom">
          <span class="sr-only">Feature</span>
        </th>
        {
          plans.map((plan) => (
            <th scope="col" class:list={["compare-head text-left align-bottom", isFeatured(plan.id) && "is-featured"]} data-col={plan.id} data-off={isFeatured(plan.id) ? undefined : ""}>
              <span class="flex items-center gap-2 text-[1.0625rem] font-semibold tracking-[-0.02em]">
                {plan.name}
                {plan.featured && <span class="rounded bg-violet-soft px-1.5 py-px text-[0.6875rem] font-semibold text-violet-ink">Popular</span>}
              </span>
              <span class="mt-1 flex items-baseline gap-1.5 font-normal">
                <Price plan={plan} class="text-[1.75rem] font-semibold tracking-[-0.045em] tabular" />
                {!!plan.monthly && <span class="text-sm text-muted">/ seat / mo</span>}
              </span>
              <a href={plan.cta.href} class:list={["btn btn-sm mt-4 w-full", isFeatured(plan.id) ? "btn-primary" : "btn-secondary"]}>
                {plan.cta.label}
              </a>
            </th>
          ))
        }
      </tr>
    </thead>
    {
      groups.map((group) => (
        <tbody>
          <tr>
            <th scope="colgroup" class="compare-group text-left">
              <span class="flex items-center gap-2.5">
                {group.icon && (
                  <span class:list={["grid size-7 shrink-0 place-items-center rounded-[8px]", softTone[group.tone ?? "ink"]]}>
                    <Icon name={group.icon} class="size-3.5" stroke={2.1} />
                  </span>
                )}
                {group.name}
              </span>
            </th>
            {plans.map((plan) => (
              <td class:list={["compare-group-fill", isFeatured(plan.id) && "is-featured"]} aria-hidden="true" />
            ))}
          </tr>
          {group.rows.map((row) => (
            <tr class="compare-row">
              <th scope="row" class="compare-cell text-left font-normal">
                <span class="block">{row.name}</span>
                {row.hint && <span class="mt-0.5 block text-[0.8125rem] text-muted">{row.hint}</span>}
              </th>
              {row.values.map((value: Cell, i) => (
                <td class:list={["compare-cell", isFeatured(plans[i].id) && "is-featured"]} data-col={plans[i].id} data-off={isFeatured(plans[i].id) ? undefined : ""}>
                  {value === true ? (
                    <>
                      <span class="grid size-5 place-items-center rounded-[8px] bg-ink text-white" aria-hidden="true">
                        <Icon name="check" class="size-3" stroke={3} />
                      </span>
                      <span class="sr-only">Included</span>
                    </>
                  ) : value === false ? (
                    <>
                      <span class="block h-px w-3 bg-faint" aria-hidden="true" />
                      <span class="sr-only">Not included</span>
                    </>
                  ) : (
                    <span>{value}</span>
                  )}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      ))
    }
  </table>
</div>

<style>
  .compare-head {
    position: sticky;
    top: var(--sticky-top, 0px);
    z-index: 10;
    padding: 1.25rem;
    background: var(--page);
    box-shadow: inset 0 -1px 0 var(--line-strong);
    transition: top 0.45s var(--ease-out-expo);
  }

  .compare-lead {
    padding-left: 0;
  }

  .compare-head.is-featured {
    border-radius: 8px;
    background: var(--wash);
  }

  .compare-group {
    padding: 2.5rem 0 0.85rem;
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    box-shadow: inset 0 -1px 0 var(--line);
  }

  .compare-group-fill {
    box-shadow: inset 0 -1px 0 var(--line);
  }

  .compare-group-fill.is-featured {
    background: var(--wash);
  }

  .compare-cell {
    padding: 0.95rem 1.25rem;
    vertical-align: middle;
    box-shadow: inset 0 -1px 0 var(--line);
  }

  th.compare-cell {
    padding-left: 0;
    font-size: 0.9375rem;
  }

  td.compare-cell {
    font-size: 0.9375rem;
    color: var(--ink-soft);
  }

  .compare-cell.is-featured {
    background: var(--wash);
  }

  tbody:last-of-type tr:last-child .compare-cell.is-featured {
    border-radius: 8px;
  }

  .compare-tab {
    height: 2.5rem;
    padding-inline: 0.25rem;
    border-radius: 8px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--muted);
    transition:
      background-color 0.2s,
      color 0.2s,
      box-shadow 0.2s;
  }

  .compare-tab[aria-pressed="true"] {
    background: var(--surface);
    color: var(--ink);
    box-shadow:
      0 1px 2px rgb(12 12 14 / 0.08),
      0 0 0 1px rgb(12 12 14 / 0.06);
  }

  /* A full-bleed band that sticks flush under the header, like a second row of it. */
  .compare-switch {
    top: var(--sticky-top, 0px);
    height: 3.25rem;
    margin-inline: calc(var(--gutter) * -1);
    padding: 0.375rem var(--gutter);
    box-shadow:
      inset 0 1px 0 var(--line),
      inset 0 -1px 0 var(--line);
    transition: top 0.45s var(--ease-out-expo);
  }

  /* Phones show one plan beside the feature names; the switcher picks it. */
  /* Grid rows on phones: a fixed table with hidden columns collapses. */
  @media (max-width: 47.99rem) {
    table,
    tbody {
      display: block;
    }

    colgroup,
    .compare-group-fill {
      display: none;
    }

    thead {
      display: block;
      position: sticky;
      top: calc(var(--sticky-top, 0px) + 3.25rem);
      z-index: 10;
      background: var(--page);
      /* Covers the margin under the switcher band. */
      box-shadow: 0 -1rem 0 var(--page);
      transition: top 0.45s var(--ease-out-expo);
    }

    tr {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    }

    .compare-head {
      position: static;
      grid-column: 1 / -1;
      padding: 0.75rem 0 1rem;
    }

    .compare-head .btn {
      display: none;
    }

    .compare-lead {
      display: none;
    }

    td.compare-cell:not([data-off]) {
      display: flex;
      align-items: center;
      padding-right: 0;
    }

    .compare-group {
      grid-column: 1 / -1;
    }

    .compare-head.is-featured,
    .compare-cell.is-featured {
      background: none;
      border-radius: 8px;
      box-shadow: inset 0 -1px 0 var(--line);
    }

    [data-off] {
      display: none;
    }
  }

  .compare-feature-col {
    width: 28%;
  }

  :global(html:not([data-header-hidden])) .compare {
    --sticky-top: var(--header-h);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>("[data-compare]").forEach((compare) => {
    const tabs = [...compare.querySelectorAll<HTMLButtonElement>("[data-show]")];
    tabs.forEach((tab) =>
      tab.addEventListener("click", () => {
        compare.querySelectorAll<HTMLElement>("[data-col]").forEach((cell) => {
          cell.toggleAttribute("data-off", cell.dataset.col !== tab.dataset.show);
        });
        tabs.forEach((other) => other.setAttribute("aria-pressed", String(other === tab)));
      }),
    );
  });
</script>
