---
import Avatar from "@/components/ui/Avatar.astro";
import AppIcon from "@/components/ui/AppIcon.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { automations } from "@/config/home";
import type { Tone } from "@/config/site";
import { softTone } from "@/lib/tones";

const { id, eyebrow, title, accent, sequences, triggers } = automations;

const steps: { day: string; icon: string; tone: Tone; title: string; stat: string }[] = [
  { day: "Day 1", icon: "mail", tone: "pink", title: "Intro email", stat: "64% opened" },
  { day: "Day 3", icon: "phone", tone: "teal", title: "Call task for owner", stat: "41% connected" },
  { day: "Day 6", icon: "mail", tone: "pink", title: "Case study follow-up", stat: "18% replied" },
  { day: "Day 10", icon: "calendar", tone: "blue", title: "Offer three times", stat: "9% booked" },
];

const actions = [
  { app: "slack", title: "Post to #wins", detail: "With deal value and owner" },
  { icon: "check-check", tone: "violet" as Tone, title: "Create onboarding task", detail: "Assigned to the CSM" },
  { app: "stripe", title: "Create the customer", detail: "Plan and seats from the deal" },
];
---

<section id={id} class="ruled section" aria-labelledby={`${id}-title`}>
  <div class="shell">
    <SectionHead id={`${id}-title`} eyebrow={eyebrow} title={title} accent={accent} />

    <div class="mt-12 grid gap-4 lg:mt-16 lg:grid-cols-2">
      <article class="card reveal grid overflow-hidden lg:row-span-2 lg:grid-rows-subgrid">
        <div class="stage dot-grid">
          <div class="w-full max-w-[24rem] rounded-xl bg-surface shadow-(--shadow-float) ring-1 ring-black/5" aria-hidden="true">
            <p class="flex items-center gap-2 border-b border-line px-4 py-3 text-[0.875rem] font-semibold">
              <span class="grid size-6 place-items-center rounded-md bg-yellow-soft text-yellow-ink"><Icon name="zap" class="size-3.5" stroke={2.2} /></span>
              New inbound, mid-market
              <span class="ml-auto rounded-md bg-green-soft px-1.5 text-[0.6875rem] font-semibold text-green-ink">Active</span>
            </p>
            <ol class="seq px-4 py-3">
              {
                steps.map((step) => (
                  <li class="relative flex items-center gap-3 py-2 text-[0.8125rem]">
                    <span class:list={["relative z-10 grid size-7 place-items-center rounded-lg", softTone[step.tone]]}>
                      <Icon name={step.icon} class="size-3.5" stroke={2.1} />
                    </span>
                    <span class="min-w-0">
                      <span class="block font-semibold">{step.title}</span>
                      <span class="block text-[0.75rem] text-faint">{step.day}</span>
                    </span>
                    <span class="ml-auto text-[0.75rem] font-medium text-muted tabular">{step.stat}</span>
                  </li>
                ))
              }
            </ol>
            <p class="flex items-center gap-2 border-t border-line bg-wash/70 px-4 py-2.5 text-[0.75rem] text-muted">
              <Avatar name="Mei Tanaka" class="size-4" />
              <span><span class="font-medium text-ink">Mei Tanaka</span> replied, sequence paused</span>
              <Icon name="circle-check" class="ml-auto size-3.5 text-green" stroke={2.2} />
            </p>
          </div>
        </div>
        <p class="copy"><strong>{sequences.title}</strong> {sequences.body}</p>
      </article>

      <article class="card reveal grid overflow-hidden lg:row-span-2 lg:grid-rows-subgrid">
        <div class="stage dot-grid">
          <div class="grid w-full max-w-[24rem] justify-items-center" aria-hidden="true">
            <div class="w-full rounded-xl bg-ink p-3.5 text-white shadow-(--shadow-float)">
              <p class="mono-label text-[0.625rem] text-white/50">When</p>
              <p class="mt-1.5 flex flex-wrap items-center gap-1.5 text-[0.875rem] font-medium">
                Deal stage changes to
                <span class="inline-flex items-center gap-1 rounded-md bg-green-soft px-1.5 text-[0.75rem] text-green-ink">
                  <span class="size-1.5 rounded-full bg-green" /> Won
                </span>
              </p>
            </div>
            <span class="h-5 w-px bg-line-strong"></span>
            <div class="w-full rounded-xl bg-surface p-1.5 shadow-(--shadow-float) ring-1 ring-black/5">
              <p class="mono-label px-2 pt-1.5 pb-1 text-[0.625rem]">Then</p>
              <ul class="grid gap-px">
                {
                  actions.map((action) => (
                    <li class="flex items-center gap-2.5 rounded-lg px-2 py-2 text-[0.8125rem]">
                      {action.app ? (
                        <AppIcon name={action.app} class="size-7" />
                      ) : (
                        <span class:list={["grid size-7 place-items-center rounded-[28%]", softTone[action.tone ?? "ink"]]}>
                          <Icon name={action.icon ?? "zap"} class="size-3.5" stroke={2.1} />
                        </span>
                      )}
                      <span>
                        <span class="block font-semibold">{action.title}</span>
                        <span class="block text-[0.75rem] text-muted">{action.detail}</span>
                      </span>
                      <span class="ml-auto grid size-4 place-items-center rounded-full bg-green text-white">
                        <Icon name="check" class="size-2.5" stroke={3.5} />
                      </span>
                    </li>
                  ))
                }
              </ul>
            </div>
          </div>
        </div>
        <p class="copy"><strong>{triggers.title}</strong> {triggers.body}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .stage {
    display: grid;
    place-items: center;
    min-height: 23rem;
    padding: 2.5rem 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .copy {
    padding: 1.4rem 1.6rem 1.6rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .copy strong {
    font-weight: 600;
    color: var(--ink);
  }

  .seq > li:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 0.875rem;
    top: 2.3rem;
    bottom: -0.6rem;
    border-left: 1.5px dashed var(--line-strong);
  }
</style>
