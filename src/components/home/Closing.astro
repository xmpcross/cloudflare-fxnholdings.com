---
import Icon from "@/components/ui/Icon.astro";
import Gradient from "@/components/ui/Gradient.astro";
import { closing } from "@/config/home";
import { siteConfig } from "@/config/site";

interface Props {
  title?: string;
  body?: string;
  class?: string;
}

const { title = closing.title, body = closing.body, class: className } = Astro.props;
const { primary, secondary } = siteConfig.actions;
---

<section class:list={["ruled py-16 sm:py-24", className]} aria-labelledby="closing-title">
  <div class="shell">
    <div
      class="reveal relative isolate overflow-hidden rounded-[8px] px-6 py-20 text-center ring-1 ring-black/5 sm:px-12 sm:py-28"
    >
      <Gradient position="35% 25%" class="inset-0 -z-10" />
      <div class="veil absolute inset-0 -z-10" aria-hidden="true"></div>
      <h2 id="closing-title" class="mx-auto max-w-3xl text-display-lg">{title}</h2>
      <p class="mx-auto mt-5 max-w-xl text-lead text-ink-soft">{body}</p>
      <div class="mt-9 flex flex-wrap justify-center gap-3">
        <a href={primary.href} class="btn btn-primary btn-lg">
          {primary.label}
          <Icon name="arrow-right" class="btn-arrow" stroke={2} />
        </a>
        <a href={secondary.href} class="btn btn-secondary btn-lg">{secondary.label}</a>
      </div>
    </div>
  </div>
</section>


<style>
  .veil {
    background: radial-gradient(60% 70% at 50% 50%, rgb(255 255 255 / 0.62), rgb(255 255 255 / 0.12));
  }
</style>
