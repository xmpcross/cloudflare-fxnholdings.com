---
import Icon from "@/components/ui/Icon.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { security } from "@/config/home";

const { id, eyebrow, title, accent, badges, items } = security;
---

<section id={id} class="ruled section" aria-labelledby={`${id}-title`}>
  <div class="shell grid gap-12 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-5">
      <SectionHead id={`${id}-title`} eyebrow={eyebrow} title={title} accent={accent} />
      <ul class="reveal mt-9 flex flex-wrap gap-2">
        {
          badges.map((badge) => (
            <li class="inline-flex items-center gap-2 rounded-[8px] bg-surface py-1.5 pr-3.5 pl-2 text-[0.875rem] font-medium shadow-[inset_0_0_0_1px_var(--line-strong)]">
              <span class="grid size-5 place-items-center rounded-[8px] bg-ink text-white">
                <Icon name="check" class="size-3" stroke={3} />
              </span>
              {badge}
            </li>
          ))
        }
      </ul>
    </div>

    <ul class="grid gap-px self-start overflow-hidden rounded-[8px] bg-line ring-1 ring-line sm:grid-cols-2 lg:col-span-7">
      {
        items.map((item) => (
          <li class="reveal bg-surface p-6 sm:p-7">
            <span class="grid size-9 place-items-center rounded-[8px] bg-wash ring-1 ring-line">
              <Icon name={item.icon} class="size-4.5" stroke={1.9} />
            </span>
            <h3 class="mt-5 text-[1.0625rem] font-semibold tracking-[-0.02em]">{item.title}</h3>
            <p class="mt-1 text-[0.9375rem] text-muted">{item.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>
