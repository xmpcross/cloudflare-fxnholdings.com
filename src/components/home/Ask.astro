---
import Avatar from "@/components/ui/Avatar.astro";
import AppIcon from "@/components/ui/AppIcon.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { ask } from "@/config/home";

const { id, eyebrow, title, accent, question, answer, points } = ask;

const steps = ["Searched 312 open deals", "Read 1,940 emails and 86 call notes", "Checked last contact on each account"];
const results: { name: string; value: string; quiet: string; owner: string; why: string }[] = [
  { name: "Aster Health", value: "$58,200", quiet: "9 days", owner: "Priya Nair", why: "Champion changed roles" },
  { name: "Harbor & Co", value: "$44,000", quiet: "8 days", owner: "Ines Duarte", why: "Renewal in 25 days" },
  { name: "Lumen Labs", value: "$84,000", quiet: "7 days", owner: "Maya Chen", why: "Waiting on redlines" },
];
const sources = [
  { label: "Email from Ava", icon: "mail" },
  { label: "Call, Oct 2", icon: "video" },
  { label: "Aster Health", icon: "building-2" },
];
---

<section id={id} class="on-night ruled section relative isolate overflow-x-clip" aria-labelledby={`${id}-title`}>
  <div class="glow" aria-hidden="true"></div>
  <div class="shell">
    <SectionHead id={`${id}-title`} eyebrow={eyebrow} title={title} accent={accent} align="center" />

    <div class="reveal mx-auto mt-12 max-w-5xl lg:mt-16">
      <div class="panel grid overflow-hidden rounded-[1.25rem] lg:grid-cols-[1fr_1.15fr]" aria-hidden="true">
        <div class="flex flex-col gap-4 p-5 sm:p-6">
          <p class="flex items-center gap-2 text-[0.8125rem] font-medium text-night-muted">
            <span class="grid size-6 place-items-center rounded-md bg-violet text-white"><Icon name="sparkles" class="size-3.5" stroke={2.2} /></span>
            Ask Modal
          </p>
          <div class="ml-auto flex max-w-[90%] items-start gap-2.5 rounded-2xl rounded-tr-md bg-white/8 px-3.5 py-2.5 text-[0.9375rem] ring-1 ring-white/10">
            {question}
            <Avatar name="Maya Chen" class="mt-0.5 size-5" />
          </div>
          <ul class="grid gap-1.5 text-[0.8125rem] text-night-muted">
            {
              steps.map((step) => (
                <li class="step flex items-center gap-2">
                  <span class="grid size-4 place-items-center rounded-full bg-green/20 text-green">
                    <Icon name="check" class="size-2.5" stroke={3.5} />
                  </span>
                  {step}
                </li>
              ))
            }
          </ul>
          <p class="answer text-[0.9375rem] leading-relaxed text-night-ink">{answer}</p>
          <ul class="answer mt-auto flex flex-wrap gap-1.5">
            {
              sources.map((source) => (
                <li class="inline-flex items-center gap-1.5 rounded-md bg-white/6 px-2 py-1 text-[0.75rem] text-night-muted ring-1 ring-white/10">
                  <Icon name={source.icon} class="size-3" />
                  {source.label}
                </li>
              ))
            }
          </ul>
          <div class="flex items-center gap-2 rounded-xl bg-white/5 px-3 py-2.5 text-[0.875rem] text-night-muted ring-1 ring-white/10">
            Ask a follow-up…
            <span class="ml-auto grid size-7 place-items-center rounded-lg bg-white text-ink"><Icon name="arrow-up" class="size-3.5" stroke={2.5} /></span>
          </div>
        </div>

        <div class="results border-t border-white/8 bg-white/[0.03] p-5 sm:p-6 lg:border-t-0 lg:border-l">
          <p class="flex items-center justify-between text-[0.8125rem]">
            <span class="font-medium">3 deals · <span class="tabular">$186,200</span></span>
            <span class="inline-flex items-center gap-1.5 rounded-md bg-white/8 px-2 py-1 text-[0.75rem] text-night-muted">
              <Icon name="table-2" class="size-3" /> Save as view
            </span>
          </p>
          <ul class="mt-4 grid gap-2.5">
            {
              results.map((row) => (
                <li class="row rounded-xl bg-surface p-3 text-ink">
                  <span class="flex items-center gap-2.5">
                    <span class="min-w-0">
                      <span class="block text-[0.875rem] font-semibold">{row.name}</span>
                      <span class="block text-[0.75rem] text-muted">{row.why}</span>
                    </span>
                    <span class="ml-auto text-right">
                      <span class="block text-[0.875rem] font-semibold tabular">{row.value}</span>
                      <span class="block text-[0.75rem] font-medium text-orange-ink tabular">Quiet {row.quiet}</span>
                    </span>
                  </span>
                  <span class="mt-2.5 flex items-center gap-2 border-t border-line pt-2.5 text-[0.75rem] text-muted">
                    <Avatar name={row.owner} class="size-4" />
                    {row.owner}
                    <span class="ml-auto inline-flex items-center gap-1 font-medium text-ink">
                      <AppIcon name="gmail" class="size-3.5" bare /> Draft follow-up
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <ul class="mt-14 grid gap-px overflow-hidden rounded-2xl bg-night-line sm:grid-cols-3 lg:mt-20">
      {
        points.map((point) => (
          <li class="reveal bg-night p-6 sm:p-7">
            <Icon name={point.icon} class="size-5 text-violet" stroke={2} />
            <h3 class="mt-4 text-[1.0625rem] font-semibold tracking-[-0.02em]">{point.title}</h3>
            <p class="mt-1 text-[0.9375rem] text-night-muted">{point.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .glow {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(40rem 22rem at 30% 52%, rgb(124 77 255 / 0.32), transparent 70%),
      radial-gradient(34rem 20rem at 72% 58%, rgb(47 107 255 / 0.24), transparent 70%),
      radial-gradient(26rem 16rem at 60% 82%, rgb(236 72 153 / 0.16), transparent 70%);
  }

  .glow::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image: radial-gradient(circle at 1px 1px, rgb(255 255 255 / 0.08) 1px, transparent 0);
    background-size: 18px 18px;
    mask-image: linear-gradient(to bottom, transparent, #000 30%, #000 70%, transparent);
  }

  .panel {
    background: rgb(24 24 27 / 0.82);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 40px 80px -30px rgb(0 0 0 / 0.6);
    backdrop-filter: blur(12px);
  }

  .results {
    border-color: rgb(255 255 255 / 0.08);
  }

  @media (prefers-reduced-motion: no-preference) {
    .step,
    .answer,
    .row {
      animation: appear linear both;
      animation-timeline: view();
      animation-range: entry 70% cover 45%;
    }
  }

  @keyframes appear {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>
