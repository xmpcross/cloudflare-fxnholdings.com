---
import Gradient from '@/components/ui/Gradient.astro';
import Icon from '@/components/ui/Icon.astro';
import SectionHead from '@/components/ui/SectionHead.astro';
import Stats from '@/components/home/Stats.astro';
import {venture,facts} from '@/config/fxn';
import portfolio from '@/data/portfolio.json';
import technologyLogos from '@/data/technologies.json';
const brands=['originfacts.com','nxt.deals','ohmnook.com','solostack.au','fxnseo.com'];

---
<section class="ruled py-9" aria-label="Selected FXN platforms"><div class="shell"><p class="text-center text-sm text-muted">A selection of the websites and tools managed under the FXN Holdings brand.</p><div class="brand-row mt-6">{brands.map(b=><a href={'https://'+b+'/'}>{b}</a>)}</div></div></section>
<section class="ruled section" aria-labelledby="areas-title"><div class="shell"><SectionHead id="areas-title" eyebrow={{label:'What we build',icon:'blocks',tone:'blue'}} title="What FXN Holdings builds and manages." lead="Our activities span five areas of digital business. Each platform serves a specific audience, from shoppers comparing products to readers researching travel or tools for their work." /><div class="area-grid mt-12">{venture.areas.map((area,i)=><a href={area.href} class:list={['area-card',i===0&&'area-feature']}><div class="area-visual"><Gradient position={i%2?'90% 80%':'10% 20%'} class="inset-0 -z-10" /><div class="area-preview"><span class="icon-tile"><Icon name={area.icon} class="size-7" /></span><span class="text-sm font-medium">{area.examples.split(' · ')[0]}</span><Icon name="arrow-up-right" class="size-4 text-blue-ink" /></div></div><div class="p-7"><h3 class="text-title">{area.title}</h3><p class="mt-3 text-muted">{area.body}</p><p class="mt-5 text-xs text-blue-ink">{area.examples}</p></div></a>)}</div></div></section>
<section class="ruled section" aria-labelledby="foundation-title"><div class="shell"><SectionHead id="foundation-title" eyebrow={{label:'Shared foundations',icon:'code',tone:'blue'}} title="Website development and ongoing platform management." lead="We bring together website development, content workflows, commerce systems and technical maintenance. Shared technology supports the platforms we manage, while each keeps its own audience and identity." /><div class="split-feature mt-12"><div class="foundation-visual"><div class="foundation-core"><Icon name="blocks" class="size-8 text-blue-ink" /><strong>FXN shared foundations</strong><span>Content · Components · Workflows</span></div><div class="connector" aria-hidden="true"></div><div class="foundation-sites">{['Commerce','Publishing','Comparison'].map((x,i)=><div><Icon name={['shopping-cart','newspaper','coins'][i]} class="size-5 text-blue-ink" /><span>{x}</span></div>)}</div></div><div class="feature-copy">{[{title:'Less repeated work',text:'Reusable components and content workflows give new projects a head start.'},{title:'Room to be different',text:'Each site can choose the content, structure and experience its visitors need.'},{title:'Improvements that travel',text:'Lessons from one platform help us build and maintain the next one better.'}].map(p=><article><h3 class="text-title">{p.title}</h3><p class="mt-3 text-muted">{p.text}</p></article>)}<a href="/technology/" class="arrow-link">See how our technology works <Icon name="arrow-right" class="size-4" /></a></div></div></div></section>
<section class="ruled section ai-section" aria-labelledby="ai-title"><div class="shell grid items-center gap-12 lg:grid-cols-2"><div><p class="eyebrow ai-label"><Icon name="sparkles" class="size-4" />Technology & AI</p><h2 id="ai-title" class="mt-6 text-display-lg">AI-assisted workflows.<br />Human editorial review.</h2><p class="mt-6 text-lead text-night-muted">AI helps with research, drafts and routine work. Our team checks the result before it reaches a reader. The aim is better work, with a person responsible for it.</p><a class="btn btn-light mt-8" href="/insights/how-we-use-ai/">Read our approach to AI</a></div><div class="review-panel"><p class="flex items-center gap-2 border-b border-night-line pb-5 text-sm"><Icon name="file-text" class="size-4" />A publishing workflow</p>{[{title:'Research & draft',body:'Gather context and prepare a first version.',icon:'search'},{title:'Check & refine',body:'Review claims, sources, clarity and relevance.',icon:'user-check'},{title:'Publish with purpose',body:'Share work that helps someone make a decision.',icon:'newspaper'}].map((p,i)=><div class="review-step"><span>{i+1}</span><div><h3 class="font-semibold">{p.title}</h3><p class="mt-1 text-sm text-night-muted">{p.body}</p></div><Icon name={p.icon} class="size-5 shrink-0" /></div>)}<p class="review-note"><Icon name="circle-check" class="size-4" />Human review before publication</p></div></div></section>
<section class="ruled section" aria-labelledby="process-title"><div class="shell"><SectionHead id="process-title" eyebrow={{label:'How we work',icon:'route',tone:'orange'}} title="How we develop and improve our platforms." lead="We keep the process practical: find a need, test the opportunity, build the platform and learn from the people who use it." /><div class="process-grid mt-12">{venture.process.map((p,i)=><article><span class="step-number">0{i+1}</span><Icon name={p.icon} class="mt-9 size-7 text-blue-ink" /><h3 class="mt-5 text-title">{p.title}</h3><p class="mt-3 text-muted">{p.body}</p></article>)}</div></div></section>
<section class="ruled section" aria-labelledby="automations-title"><div class="shell"><SectionHead id="automations-title" eyebrow={{label:'Automations',icon:'zap',tone:'orange'}} title="Automation for everyday platform operations." lead="Shared workflows help us handle repeatable work across our managed platforms, while people remain responsible for decisions and final checks." /><div class="automation-cards mt-12"><article><img src="/img/modal/automation-1.png" alt="Illustrative automation sequence showing scheduled follow-ups and a pause when a reply arrives" width="600" height="419" loading="lazy" /><div class="p-7"><h3 class="text-title">Give every task a next step.</h3><p class="mt-3 text-muted">Organised sequences help keep routine work moving. Use automation for repeatable steps and human judgement for the exceptions.</p></div></article><article><img src="/img/modal/automation-2.png" alt="Illustrative trigger workflow connecting a status change to notifications, tasks and a customer record" width="600" height="419" loading="lazy" /><div class="p-7"><h3 class="text-title">Connect the handoffs.</h3><p class="mt-3 text-muted">Tools such as n8n help us connect services and reduce manual handovers between stages of the work.</p></div></article></div><p class="mt-5 text-sm text-muted">Illustrative workflows; names and activity figures are sample data.</p></div></section>
<Stats items={facts} />
<section class="ruled section overflow-x-clip" id="technologies" aria-labelledby="technologies-title"><div class="shell"><SectionHead id="technologies-title" align="center" eyebrow={{label:'Technologies we use',icon:'blocks',tone:'blue'}} title="Web technologies and open-source platforms." lead="We build with modern web frameworks, open-source content systems and established commerce platforms. Shared tools help us launch efficiently, maintain our websites and improve the experience over time." /><p class="mt-5 text-center text-sm text-muted">From Next.js and React to WordPress and WooCommerce, we choose the stack to fit each website. Automation and cloud infrastructure keep the work connected.</p><div class="logo-marquee mt-12" aria-label="Web frameworks, content platforms, commerce and infrastructure">{[technologyLogos.slice(0,6),technologyLogos.slice(6)].map((row,i)=><div class="logo-track" style={`--direction:${i===0?'normal':'reverse'}`}>{[0,1].map(copy=><ul aria-hidden={copy===1?'true':undefined}>{row.map(logo=><li><img src={logo.src} alt="" width="28" height="28" loading="lazy" /><span>{logo.name}</span></li>)}</ul>)}</div>)}</div><p class="mt-10 text-center"><a href="/technology/" class="btn btn-secondary">Explore our technology <Icon name="arrow-right" class="size-4" /></a></p></div></section>
<section class="ruled section bg-wash" id="platforms" aria-labelledby="platforms-title"><div class="shell"><SectionHead id="platforms-title" eyebrow={{label:'Managed platforms',icon:'globe',tone:'blue'}} title="Our websites, web applications and platforms." lead="Browse all 14 platforms currently managed under the FXN Holdings brand. Each listing explains what the website offers and links directly to it." /><div class="platform-directory mt-12">{portfolio.map(p=><article class="story-card"><p class="text-sm text-blue-ink">{p.category}</p><h3 class="mt-4 text-title"><a href={p.href}>{p.name}</a></h3><p class="mt-3 text-muted">{p.description}</p><a href={p.href} class="mt-6 inline-flex items-center gap-2 arrow-link" aria-label={'Visit '+p.name}>Visit website <Icon name="arrow-up-right" class="size-4" /></a></article>)}</div><p class="mt-6 text-sm text-muted">Each platform has its own terms, privacy information and commercial disclosures. Check those details for the business responsible for a particular service or purchase.</p></div></section>
<section class="ruled section" aria-labelledby="partnerships-title"><div class="shell"><SectionHead id="partnerships-title" eyebrow={{label:'Work with FXN Holdings',icon:'globe',tone:'blue'}} title="Partnerships, suppliers and commercial opportunities." lead="We welcome relevant proposals from brands, suppliers, affiliate networks, advertisers and platform founders. Tell us which audience or platform your proposal serves and how you would like to work together." /><div class="process-grid mt-10">{[{title:'Suppliers and brands',body:'Products, catalogues and services relevant to the people using our commerce and comparison platforms.'},{title:'Affiliate partnerships',body:'Retailer and network relationships that connect visitors with relevant products and offers.'},{title:'Advertising',body:'Enquiries about relevant sponsored content and advertising opportunities on our managed websites.'},{title:'Platform opportunities',body:'Ideas and collaborations that support a useful website, web application or digital service.'}].map(p=><article><h3 class="text-title">{p.title}</h3><p class="mt-3 text-muted">{p.body}</p></article>)}</div><a class="arrow-link mt-8 inline-flex" href="/contact/">Contact FXN Holdings <Icon name="arrow-right" class="size-4" /></a></div></section>
<section class="ruled section" aria-labelledby="standards-title"><div class="shell"><SectionHead id="standards-title" eyebrow={{label:'Built with care',icon:'shield-check',tone:'blue'}} title="Clear information for every market we serve." lead="A platform needs more than working code. Clear policies, transparent commercial relationships and appropriate local setup are part of how we build." /><div class="standards-grid mt-12">{venture.safeguards.map(p=><article><span class="icon-tile"><Icon name={p.icon} class="size-5" /></span><h3 class="mt-7 text-title">{p.title}</h3><p class="mt-3 text-muted">{p.body}</p></article>)}</div></div></section>
<style>
.platform-directory{display:grid;gap:1rem}.platform-directory article{min-width:0}.platform-directory h3{overflow-wrap:anywhere}@media(min-width:40rem){.platform-directory{grid-template-columns:repeat(2,minmax(0,1fr))}}@media(min-width:64rem){.platform-directory{grid-template-columns:repeat(3,minmax(0,1fr))}}
.automation-cards{display:grid;gap:1.25rem}.automation-cards article{overflow:hidden;border:1px solid var(--line);border-radius:1.25rem;background:var(--surface)}.automation-cards img{display:block;width:100%;height:auto;border-bottom:1px solid var(--line)}.logo-marquee{overflow:hidden;display:grid;gap:1rem;mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}.logo-track{display:flex;width:max-content}.logo-track ul{display:flex;flex-shrink:0;gap:1rem;padding-right:1rem}.logo-track li{display:flex;align-items:center;gap:.9rem;background:white;border:1px solid var(--line);border-radius:1rem;padding:1rem 1.4rem;font-weight:500;white-space:nowrap}.logo-track img{width:28px;height:28px}.logo-marquee:hover .logo-track{animation-play-state:paused}@media(prefers-reduced-motion:no-preference){.logo-track{animation:logos 70s linear infinite var(--direction)}}@keyframes logos{to{transform:translateX(-50%)}}@media(min-width:64rem){.automation-cards{grid-template-columns:repeat(2,minmax(0,1fr))}}

.brand-row{display:flex;flex-wrap:wrap;justify-content:space-around;gap:1.5rem;font-size:1.2rem;font-weight:600;letter-spacing:-.03em}.brand-row a:hover{color:var(--blue)}.area-grid{display:grid;gap:1.25rem}.area-card{border:1px solid var(--line);border-radius:1.25rem;overflow:hidden;background:var(--surface)}.area-visual{position:relative;isolation:isolate;display:grid;place-items:center;padding:2rem;min-height:11rem}.area-preview{display:flex;align-items:center;gap:1rem;max-width:100%;padding:1rem;background:#fffffff2;border:1px solid var(--line);border-radius:1rem;box-shadow:var(--shadow-float)}.area-preview span:nth-child(2){overflow-wrap:anywhere}.icon-tile{display:inline-grid;place-items:center;flex-shrink:0;width:3rem;height:3rem;border-radius:.8rem;background:var(--blue-soft);color:var(--blue-ink)}.split-feature{display:grid;gap:2rem}.foundation-visual{display:flex;flex-direction:column;justify-content:center;background:var(--wash);border:1px solid var(--line);border-radius:1.5rem;padding:2rem}.foundation-core{display:grid;justify-items:center;gap:1rem;background:white;border:1px solid var(--line);border-radius:1rem;padding:2rem;text-align:center;box-shadow:var(--shadow-card)}.foundation-core span{font-size:.75rem;color:var(--muted)}.connector{width:1px;height:3rem;background:var(--blue);margin:auto}.foundation-sites{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.5rem}.foundation-sites div{display:grid;justify-items:center;gap:.75rem;padding:1rem .25rem;background:white;border:1px solid var(--line);border-radius:.75rem;font-size:.7rem}.feature-copy{display:grid;gap:2rem;padding:1rem}.ai-section{background:var(--night);color:var(--night-ink)}.ai-label{background:#0062de30;color:#9fc7ff}.review-panel{border:1px solid var(--night-line);background:var(--night-raised);border-radius:1.5rem;padding:1.5rem}.review-step{display:flex;align-items:center;gap:1rem;padding:1.5rem 0}.review-step>span{display:grid;place-items:center;flex-shrink:0;width:2rem;height:2rem;border-radius:50%;background:#0062de40;color:#b8d5ff}.review-step>div{flex:1}.review-note{display:flex;align-items:center;gap:.6rem;border-top:1px solid var(--night-line);padding-top:1.25rem;font-size:.8rem;color:#b8d5ff}.process-grid{display:grid;gap:1px;background:var(--line);border:1px solid var(--line);border-radius:1.25rem;overflow:hidden}.process-grid article{background:var(--surface);padding:2rem}.step-number{font-size:.8rem;color:var(--blue)}.signal-panel{padding:2rem;border:1px solid var(--line);border-radius:1.5rem;background:var(--wash)}.signal-row{display:flex;align-items:center;gap:1.25rem;padding:1.5rem 0;border-bottom:1px solid var(--line)}.signal-row:last-child{border:0}.stack-list{display:flex;justify-content:center;flex-wrap:wrap;gap:1rem;max-width:64rem;margin-inline:auto}.stack-list>div{display:flex;align-items:center;gap:.75rem;border:1px solid var(--line);border-radius:1rem;padding:.8rem 1.2rem;background:var(--surface)}.stack-initial{display:grid;place-items:center;width:2rem;height:2rem;background:var(--blue-soft);color:var(--blue);border-radius:.5rem;font-weight:700}.stories-grid{display:grid;gap:1.25rem}.story-feature{position:relative;isolation:isolate;overflow:hidden;display:flex;flex-direction:column;border-radius:1.25rem;padding:2rem}.story-card{display:block;border:1px solid var(--line);border-radius:1.25rem;background:var(--surface);padding:2rem}.standards-grid{display:grid;gap:2rem}
@media(min-width:40rem){.area-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.area-feature{grid-column:span 2;display:grid;grid-template-columns:1fr 1fr}.process-grid,.standards-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(min-width:64rem){.split-feature,.stories-grid{grid-template-columns:1.1fr 1fr}.standards-grid,.process-grid{grid-template-columns:repeat(4,minmax(0,1fr))}.foundation-visual{padding:3rem}.review-panel{padding:2rem}.story-feature{padding:3rem}}
</style>
