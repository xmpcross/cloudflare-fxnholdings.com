---
import Pill from "@/components/app/Pill.astro";
import AppIcon from "@/components/ui/AppIcon.astro";
import Avatar from "@/components/ui/Avatar.astro";
import Icon from "@/components/ui/Icon.astro";
import Gradient from "@/components/ui/Gradient.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import { dataModel } from "@/config/home";
import type { Tone } from "@/config/site";
import { softTone } from "@/lib/tones";

const { id, eyebrow, title, accent, cards } = dataModel;

const objects: { name: string; icon: string; tone: Tone; count: string; custom?: boolean }[] = [
  { name: "Companies", icon: "building-2", tone: "blue", count: "1,248" },
  { name: "People", icon: "user-round", tone: "green", count: "6,904" },
  { name: "Deals", icon: "circle-dot", tone: "orange", count: "312" },
  { name: "Investors", icon: "landmark", tone: "violet", count: "86", custom: true },
  { name: "Partners", icon: "handshake", tone: "teal", count: "41", custom: true },
];

const fields: { name: string; icon: string; tone: Tone }[] = [
  { name: "Text", icon: "type", tone: "ink" },
  { name: "Currency", icon: "dollar-sign", tone: "green" },
  { name: "Status", icon: "circle-dot", tone: "orange" },
  { name: "Relationship", icon: "link-2", tone: "blue" },
  { name: "Date", icon: "calendar", tone: "pink" },
  { name: "Rating", icon: "star", tone: "yellow" },
  { name: "Number", icon: "hash", tone: "teal" },
  { name: "Email", icon: "at-sign", tone: "ink" },
  { name: "AI research", icon: "sparkles", tone: "violet" },
  { name: "Phone", icon: "phone", tone: "ink" },
  { name: "Select", icon: "list-filter", tone: "blue" },
];

const imports = [
  { label: "Contacts", value: "6,904", done: 100 },
  { label: "Deals and history", value: "312", done: 100 },
  { label: "Custom fields", value: "48", done: 72 },
];
---

<section id={id} class="ruled section" aria-labelledby={`${id}-title`}>
  <div class="shell">
    <SectionHead id={`${id}-title`} eyebrow={eyebrow} title={title} accent={accent} />

    <div class="mt-12 grid gap-4 lg:mt-16 lg:grid-cols-12">
      <article class="bento reveal lg:col-span-7">
        <div class="visual">
          <Gradient position="20% 30%" class="inset-0 -z-10" />
          <div class="relative mx-auto w-full max-w-[26rem]">
            <div class="rounded-[8px] bg-surface p-1.5 shadow-(--shadow-float) ring-1 ring-black/5" aria-hidden="true">
              <p class="flex items-center justify-between px-2.5 pt-1.5 pb-2 text-[0.75rem] font-medium text-muted">
                Objects <Icon name="plus" class="size-3.5" />
              </p>
              <ul class="grid gap-px">
                {
                  objects.map((object) => (
                    <li class:list={["flex items-center gap-2.5 rounded-[8px] px-2.5 py-1.5 text-[0.875rem]", object.name === "Investors" && "bg-violet-soft/60"]}>
                      <span class:list={["grid size-6 place-items-center rounded-[8px]", softTone[object.tone]]}>
                        <Icon name={object.icon} class="size-3.5" stroke={2.1} />
                      </span>
                      <span class="font-medium">{object.name}</span>
                      {object.custom && <Pill tone={object.tone}>Custom</Pill>}
                      <span class="ml-auto text-[0.8125rem] text-muted tabular">{object.count}</span>
                    </li>
                  ))
                }
              </ul>
            </div>
            <div class="absolute -right-2 -bottom-6 w-52 rounded-[8px] bg-surface p-3 shadow-(--shadow-float) ring-1 ring-black/5 sm:-right-10" aria-hidden="true">
              <p class="text-[0.75rem] font-medium text-muted">New object</p>
              <p class="mt-1.5 flex h-8 items-center rounded-[8px] px-2.5 text-[0.875rem] font-medium shadow-[0_0_0_1px_var(--blue),0_0_0_3px_var(--blue-soft)]">
                Workspaces<span class="caret" />
              </p>
              <p class="mt-2.5 flex items-center gap-1.5">
                {["bg-blue", "bg-violet", "bg-orange", "bg-green", "bg-pink", "bg-yellow"].map((color, index) => (
                  <span class:list={["size-4 rounded-[8px]", color, index === 4 && "ring-2 ring-pink ring-offset-2"]} />
                ))}
              </p>
            </div>
          </div>
        </div>
        <p class="copy"><strong>{cards.objects.title}.</strong> {cards.objects.body}</p>
      </article>

      <article class="bento reveal lg:col-span-5">
        <div class="visual dot-grid">
          <ul class="flex max-w-[22rem] flex-wrap justify-center gap-2" aria-hidden="true">
            {
              fields.map((field, index) => (
                <li class="field flex items-center gap-1.5 rounded-[8px] bg-surface py-1 pr-2.5 pl-1 text-[0.8125rem] font-medium shadow-[0_0_0_1px_var(--line),0_1px_2px_rgb(12_12_14/0.05)]" style={`--i:${index}`}>
                  <span class:list={["grid size-5 place-items-center rounded-[8px]", softTone[field.tone]]}>
                    <Icon name={field.icon} class="size-3" stroke={2.2} />
                  </span>
                  {field.name}
                </li>
              ))
            }
          </ul>
        </div>
        <p class="copy"><strong>{cards.attributes.title}.</strong> {cards.attributes.body}</p>
      </article>

      <article class="bento reveal lg:col-span-5">
        <div class="visual dot-grid">
          <div class="relative h-56 w-full max-w-[22rem]" aria-hidden="true">
            <svg class="absolute inset-0 size-full" viewBox="0 0 352 224" fill="none" stroke="var(--line-strong)" stroke-width="1.5">
              <path d="M176 112C120 112 120 40 70 40" />
              <path d="M176 112C120 112 120 184 70 184" />
              <path d="M176 112C232 112 232 40 282 40" stroke="var(--orange)" stroke-dasharray="3 4" />
              <path d="M176 112C232 112 232 184 282 184" />
            </svg>
            <span class="node top-1/2 left-1/2 -translate-1/2 bg-surface px-2.5 py-2 shadow-(--shadow-float)">
              <span class="font-semibold">Lumen Labs</span>
            </span>
            <span class="node top-[18%] left-[20%] -translate-1/2"><Avatar name="Ava Lindqvist" class="size-5" /> Ava</span>
            <span class="node top-[82%] left-[20%] -translate-1/2"><Avatar name="Tom Reyes" class="size-5" /> Tom</span>
            <span class="node top-[18%] left-[80%] -translate-1/2"><span class="size-2 rounded-[8px] bg-orange" /> $84k deal</span>
            <span class="node top-[82%] left-[80%] -translate-1/2"><Icon name="handshake" class="size-3.5 text-muted" /> Partner</span>
          </div>
        </div>
        <p class="copy"><strong>{cards.relations.title}.</strong> {cards.relations.body}</p>
      </article>

      <article class="bento reveal lg:col-span-7">
        <div class="visual">
          <Gradient position="75% 60%" class="inset-0 -z-10" />
          <div class="w-full max-w-[26rem] rounded-[8px] bg-surface p-4 shadow-(--shadow-float) ring-1 ring-black/5" aria-hidden="true">
            <p class="flex items-center gap-2 text-[0.875rem] font-semibold">
              <AppIcon name="salesforce" class="size-7" />
              <Icon name="arrow-right" class="size-3.5 text-faint" />
              <span class="grid size-7 place-items-center rounded-[8px] bg-ink text-white"><Icon name="import" class="size-3.5" stroke={2} /></span>
              Importing from Salesforce
              <span class="ml-auto text-[0.75rem] font-medium text-muted tabular">2 min left</span>
            </p>
            <ul class="mt-4 grid gap-3 text-[0.8125rem]">
              {
                imports.map((item) => (
                  <li>
                    <span class="flex items-center gap-2">
                      {item.done === 100 ? (
                        <span class="grid size-4 place-items-center rounded-[8px] bg-green text-white">
                          <Icon name="check" class="size-2.5" stroke={3.5} />
                        </span>
                      ) : (
                        <span class="spinner size-4 rounded-[8px]" />
                      )}
                      <span class="font-medium">{item.label}</span>
                      <span class="ml-auto text-muted tabular">{item.value}</span>
                    </span>
                    <span class="mt-1.5 block h-1 overflow-hidden rounded-[8px] bg-sunken">
                      <span class:list={["block h-full rounded-[8px]", item.done === 100 ? "bg-green" : "bg-blue"]} style={`width:${item.done}%`} />
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
        <p class="copy"><strong>{cards.import.title}.</strong> {cards.import.body}</p>
      </article>
    </div>
  </div>
</section>

<style>
  .bento {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border-radius: 8px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  @media (min-width: 64rem) {
    .bento {
      grid-row: span 2;
      grid-template-rows: subgrid;
    }
  }

  .visual {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    place-items: center;
    min-height: 19rem;
    padding: 2.5rem 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .copy {
    padding: 1.4rem 1.6rem 1.6rem;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.5;
  }

  .copy strong {
    font-weight: 600;
    color: var(--ink);
  }

  .node {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;
    border-radius: 8px;
    background: var(--surface);
    padding: 0.3rem 0.6rem 0.3rem 0.35rem;
    font-size: 0.8125rem;
    font-weight: 500;
    box-shadow:
      0 0 0 1px var(--line),
      0 1px 2px rgb(12 12 14 / 0.05);
  }

  .caret {
    display: inline-block;
    width: 1.5px;
    height: 1em;
    margin-left: 2px;
    background: var(--ink);
  }

  .spinner {
    border: 2px solid var(--blue-soft);
    border-top-color: var(--blue);
  }

  @media (prefers-reduced-motion: no-preference) {
    .caret {
      animation: blink 1.1s steps(1) infinite;
    }

    .spinner {
      animation: spin 0.9s linear infinite;
    }

    .bento:hover .field {
      animation: nudge 0.5s var(--ease-out-expo) both;
      animation-delay: calc(var(--i) * 25ms);
    }
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  @keyframes spin {
    to {
      transform: rotate(1turn);
    }
  }

  @keyframes nudge {
    50% {
      transform: translateY(-3px);
    }
  }
</style>
