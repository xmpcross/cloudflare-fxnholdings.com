---
import AppWindow from "@/components/app/AppWindow.astro";
import DashboardView from "@/components/app/DashboardView.astro";
import PipelineView from "@/components/app/PipelineView.astro";
import RecordsView from "@/components/app/RecordsView.astro";
import RecordView from "@/components/app/RecordView.astro";
import ReportsView from "@/components/app/ReportsView.astro";
import Sidebar from "@/components/app/Sidebar.astro";
import Icon from "@/components/ui/Icon.astro";
import Gradient from "@/components/ui/Gradient.astro";
import { hero } from "@/config/home";
import { siteConfig } from "@/config/site";
import { textTone } from "@/lib/tones";

const { primary, secondary } = siteConfig.actions;
const { announcement } = siteConfig;
const sidebarFor = { dashboard: "Home", records: "Companies", pipeline: "Sales pipeline", record: "Companies", reports: "Home" };
---

<section class="relative isolate -mt-(--header-h) pt-(--header-h)" aria-labelledby="hero-title">
  <div class="hero-field pointer-events-none absolute inset-x-0 top-0 -z-10 h-[46rem]" aria-hidden="true"></div>

  <div class="shell pt-12 text-center sm:pt-20">
    {
      announcement.enabled && (
        <a
          href={announcement.href}
          class="rise group inline-flex max-w-full items-center gap-2.5 rounded-full bg-surface py-1 pr-3 pl-1 text-sm shadow-[0_0_0_1px_var(--line-strong),0_1px_2px_rgb(12_12_14/0.06)] transition-colors hover:bg-wash"
        >
          <span class="rounded-full bg-ink px-2 py-0.5 text-xs font-semibold text-white">{announcement.badge}</span>
          <span class="truncate font-medium">{announcement.text}</span>
          <Icon name="arrow-right" class="btn-arrow size-3.5 text-muted" stroke={2} />
        </a>
      )
    }

    <h1 id="hero-title" class="rise mx-auto mt-7 max-w-[15ch] text-display-xl" style="--i:1">{hero.title}</h1>
    <p class="rise mx-auto mt-6 max-w-[38rem] text-lead text-ink-soft" style="--i:2">{hero.lead}</p>

    <div class="rise mt-9 flex flex-wrap justify-center gap-3" style="--i:3">
      <a href={primary.href} class="btn btn-primary btn-lg">
        {primary.label}
        <Icon name="arrow-right" class="btn-arrow" stroke={2} />
      </a>
      <a href={secondary.href} class="btn btn-secondary btn-lg">{secondary.label}</a>
    </div>

    <ul class="rise mt-6 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-ink-soft" style="--i:4">
      {
        hero.notes.map((note) => (
          <li class="inline-flex items-center gap-1.5">
            <Icon name="circle-check" class="size-4 text-green-ink" stroke={2} />
            {note}
          </li>
        ))
      }
    </ul>
  </div>

  <div id="product-tour" class="shell mt-14 scroll-mt-24 sm:mt-16" data-tabs>
    <div class="canvas rise relative isolate overflow-hidden rounded-[1.75rem] px-2.5 py-5 sm:px-8 sm:py-8 lg:px-14 lg:py-12" style="--i:5">
      <Gradient eager position="50% 35%" class="inset-0 -z-10" />
      <div class="tabbar mx-auto grid grid-cols-4 gap-1 rounded-2xl p-1 sm:flex sm:w-fit" role="tablist" aria-label={`${siteConfig.name} product tour`}>
        {
          hero.tabs.map((tab, index) => (
            <button
              type="button"
              id={`hero-tab-${tab.id}`}
              class="hero-tab"
              role="tab"
              aria-selected={index === 0 ? "true" : "false"}
              aria-controls={`hero-panel-${tab.id}`}
              tabindex={index === 0 ? 0 : -1}
              data-tab
            >
              <Icon name={tab.icon} class:list={["size-4", textTone[tab.tone]]} stroke={2} />
              {tab.label}
            </button>
          ))
        }
      </div>

      <AppWindow fade class="mx-auto mt-5 max-w-[68rem] sm:mt-6">
        <div class="grid h-136 grid-cols-[minmax(0,1fr)] sm:h-148">
          {
            hero.tabs.map((tab, index) => (
              <div
                id={`hero-panel-${tab.id}`}
                class="hero-panel flex min-h-0 min-w-0"
                role="tabpanel"
                aria-labelledby={`hero-tab-${tab.id}`}
                data-panel
                data-active={index === 0 ? "" : undefined}
                inert={index !== 0}
              >
                <div class="hidden lg:flex">
                  <Sidebar active={sidebarFor[tab.view]} />
                </div>
                {tab.view === "dashboard" && <DashboardView />}
                {tab.view === "records" && <RecordsView />}
                {tab.view === "pipeline" && <PipelineView />}
                {tab.view === "record" && <RecordView />}
                {tab.view === "reports" && <ReportsView />}
              </div>
            ))
          }
        </div>
      </AppWindow>
    </div>
  </div>
</section>

<style>
  /* Dots behind the headline, between the rails. */
  .hero-field {
    background-image: radial-gradient(circle at 1px 1px, rgb(12 12 14 / 0.11) 1px, transparent 0);
    background-size: 18px 18px;
    mask-image: radial-gradient(70% 80% at 50% 0%, #000 30%, transparent 85%);
  }

  .hero-field::before {
    content: "";
    position: absolute;
    inset: 0;
    width: min(100%, calc(var(--measure) + var(--gutter) * 2));
    margin-inline: auto;
    border-inline: 1px solid var(--line);
  }

  .canvas {
    box-shadow: inset 0 0 0 1px rgb(12 12 14 / 0.06);
  }

  .tabbar {
    background: rgb(255 255 255 / 0.32);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.55),
      0 0 0 1px rgb(12 12 14 / 0.05),
      0 8px 24px -12px rgb(12 12 14 / 0.25);
    backdrop-filter: blur(20px) saturate(1.4);
  }

  .hero-tab {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.5rem 0.25rem;
    border-radius: 0.75rem;
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--ink);
    transition:
      background-color 0.25s,
      box-shadow 0.25s;
  }

  @media (min-width: 40rem) {
    .hero-tab {
      flex: none;
      flex-direction: row;
      gap: 0.5rem;
      padding: 0.55rem 1rem;
      font-size: 0.9375rem;
    }
  }

  .hero-tab:hover {
    background: rgb(255 255 255 / 0.35);
  }

  .hero-tab[aria-selected="true"] {
    background: #fff;
    color: var(--ink);
    box-shadow: 0 1px 2px rgb(12 12 14 / 0.08), 0 0 0 1px rgb(12 12 14 / 0.04);
  }

  .hero-panel {
    grid-area: 1 / 1;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.35s;
  }

  .hero-panel[data-active] {
    opacity: 1;
    pointer-events: auto;
  }
</style>

<script>
  import { initTabs } from "@/scripts/tabs";
  initTabs();
</script>
