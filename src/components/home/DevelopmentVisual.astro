<style>
.development-visual{min-width:0;width:100%;overflow:hidden;border:1px solid #dce5f2;border-radius: 8px;background:linear-gradient(140deg,#f4f8ff,#fff 70%,#fff4f1);box-shadow:0 16px 55px #233c6310}.visual-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem;padding:1.4rem 1.5rem 0;font:500 .59rem monospace;letter-spacing:.08em;color:var(--muted)}.visual-heading>span:first-child{display:flex;align-items:center;gap:.5rem}.status-dot{width:6px;height:6px;border-radius: 8px;background:var(--blue)}svg{display:block;width:100%;height:auto}figcaption{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.5rem;border-top:1px solid var(--line);font-size:.75rem;color:var(--muted)}button{display:flex;align-items:center;gap:.4rem;padding:.4rem .65rem;border:1px solid var(--line);border-radius: 8px;background:white;color:var(--ink)}button:focus-visible{outline:2px solid var(--blue);outline-offset:3px}.code-line,.page-block,.ready-badge{transform-box:fill-box;transform-origin:center}.line-one{--delay:0s}.line-two{--delay:.35s}.line-three{--delay:.7s}.line-four{--delay:1.05s}.block-one{--delay:1.5s}.block-two{--delay:1.9s}.block-three{--delay:2.3s}.ready-badge{--delay:2.8s}.signal-two{--delay:.4s}.signal-three{--delay:.8s}
@media(prefers-reduced-motion:no-preference){.code-line,.page-block,.ready-badge{animation:assemble 10s cubic-bezier(.23,1,.32,1) var(--delay,0s) infinite both}.signal{animation:connect 10s linear var(--delay,0s) infinite}.development-visual[data-paused] :is(.code-line,.page-block,.ready-badge,.signal){animation-play-state:paused}}
@keyframes assemble{0%,4%{opacity:0;transform:translateY(5px)}12%,82%{opacity:1;transform:translateY(0)}94%,100%{opacity:0;transform:translateY(0)}}@keyframes connect{0%,38%{opacity:0;transform:translateY(0)}42%{opacity:1}63%{opacity:0;transform:translateY(42px)}100%{opacity:0;transform:translateY(42px)}}@media(prefers-reduced-motion:reduce){button{display:none}}@media(max-width:400px){.version{display:none}.visual-heading{padding-inline:1rem}figcaption{padding-inline:1rem}}
</style>
<script>
const visual=document.querySelector<HTMLElement>('[data-development-visual]');
const toggle=visual?.querySelector<HTMLButtonElement>('[data-motion-toggle]');
toggle?.addEventListener('click',()=>{if(!visual)return;const paused=visual.toggleAttribute('data-paused');toggle.setAttribute('aria-pressed',String(paused));toggle.setAttribute('aria-label',`${paused?'Resume':'Pause'} development animation`);const label=toggle.querySelector('[data-motion-label]');if(label)label.textContent=paused?'Resume':'Pause';});
</script>
