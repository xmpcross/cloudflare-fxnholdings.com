---
import Icon from "@/components/ui/Icon.astro";

interface Props {
  id?: string;
  title: string;
  items: { q: string; a: string }[];
  class?: string;
}

const { id = "faq", title, items, class: className } = Astro.props;
---

<section id={id} class:list={["ruled section", className]} aria-labelledby={`${id}-title`}>
  <div class="shell grid gap-10 lg:grid-cols-12">
    <div class="reveal lg:col-span-4">
      <h2 id={`${id}-title`} class="text-display-md">{title}</h2>
      <p class="mt-4 text-muted">
        Something else? <a href="/contact/" class="link text-ink">Ask the team</a>
      </p>
    </div>
    <div class="grid gap-2 lg:col-span-8">
      {
        items.map((item) => (
          <details class="faq group rounded-[8px] bg-wash transition-colors open:bg-surface open:shadow-[inset_0_0_0_1px_var(--line-strong)]" name={id}>
            <summary class="flex cursor-pointer items-center justify-between gap-6 px-5 py-4.5 text-[1.0625rem] font-medium tracking-[-0.02em] sm:px-6">
              {item.q}
              <span class="grid size-7 shrink-0 place-items-center rounded-[8px] bg-surface shadow-[inset_0_0_0_1px_var(--line)] transition-colors group-open:bg-ink group-open:text-white group-open:shadow-none">
                <Icon name="plus" class="faq-plus size-3.5" stroke={2.25} />
              </span>
            </summary>
            <p class="max-w-2xl px-5 pb-5 text-muted sm:px-6">{item.a}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq summary {
    list-style: none;
  }

  .faq summary::-webkit-details-marker {
    display: none;
  }

  .faq :global(.faq-plus) {
    transition: transform 0.3s var(--ease-out-expo);
  }

  .faq[open] :global(.faq-plus) {
    transform: rotate(45deg);
  }
</style>
