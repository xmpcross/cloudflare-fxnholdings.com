---
import Pill from "@/components/app/Pill.astro";
import Avatar from "@/components/ui/Avatar.astro";
import Icon from "@/components/ui/Icon.astro";
import type { Tone } from "@/config/site";
import type { DealFlowCard } from "@/config/solutions";
import { dotTone } from "@/lib/tones";
import ViewHeader from "./ViewHeader.astro";

interface Props {
  title: string;
  deployed: { value: string; of: string };
  columns: { name: string; tone: Tone; cards: DealFlowCard[] }[];
}

const { title, deployed, columns } = Astro.props;
const strengthTone = (strength: number) => (strength > 2 ? "bg-green" : strength > 1 ? "bg-yellow" : "bg-orange");
---

<div class="dealflow flex min-w-0 flex-1 flex-col">
  <ViewHeader title={title} tone="violet" layout="Board">
    <span>Deployed <span class="font-semibold text-ink tabular">{deployed.value}</span> of {deployed.of}</span>
    <span class="flex -space-x-1.5">
      <Avatar name="Maya Chen" class="size-5 ring-2 ring-surface" />
      <Avatar name="Leo Brandt" class="size-5 ring-2 ring-surface" />
      <Avatar name="Priya Nair" class="size-5 ring-2 ring-surface" />
    </span>
  </ViewHeader>

  <div class="board flex gap-2.5 overflow-hidden bg-[#fafafb] p-3">
    {
      columns.map((column, c) => (
        <div class="column flex w-[13.25rem] shrink-0 flex-col gap-2 rounded-[8px] bg-sunken/60 p-1.5">
          <div class="flex items-center gap-1.5 px-1.5 pt-1 text-[0.8125rem] font-semibold">
            <span class:list={["size-2 rounded-[8px]", dotTone[column.tone]]} />
            {column.name}
            <span class="font-normal text-faint tabular">{column.cards.length}</span>
          </div>
          {column.cards.map((card, d) => (
            <div class="deal rounded-[8px] bg-surface p-2.5 shadow-[0_0_0_1px_var(--line),0_1px_2px_rgb(12_12_14/0.05)]" style={`--d:${c * 90 + d * 60}ms`}>
              <span class="block truncate text-[0.8125rem] font-semibold">{card.company}</span>
              <p class="mt-1 truncate text-[0.75rem] text-muted">{card.pitch}</p>
              <div class="mt-2 flex items-center gap-1.5">
                <span class="truncate text-[0.8125rem] font-semibold tabular">{card.round}</span>
                {card.tag && (
                  <Pill tone={card.tag.tone} class="ml-auto">
                    {card.tag.label}
                  </Pill>
                )}
              </div>
              <div class="mt-2 flex items-center gap-1.5 border-t border-line pt-2 text-[0.6875rem] text-muted">
                <Icon name="link-2" class="size-3 text-faint" />
                <span>via</span>
                <Avatar name={card.intro.via} class="size-4" />
                <span class="truncate font-medium text-ink-soft">{card.intro.via}</span>
                <span class="ml-auto flex items-end gap-0.5">
                  {[1, 2, 3, 4].map((bar) => (
                    <span class:list={["w-[3px] rounded-[8px]", bar <= card.intro.strength ? strengthTone(card.intro.strength) : "bg-line-strong"]} style={`height:${bar * 2 + 2}px`} />
                  ))}
                </span>
              </div>
            </div>
          ))}
          <span class="flex items-center gap-1.5 px-1.5 pb-1 text-[0.75rem] text-faint">
            <Icon name="plus" class="size-3" /> Add company
          </span>
        </div>
      ))
    }
  </div>
</div>

<style>
  .dealflow {
    container-type: inline-size;
  }

  .board {
    flex: 1;
    align-items: flex-start;
    mask-image: linear-gradient(90deg, #000 88%, transparent);
  }

  @container (max-width: 30rem) {
    .board {
      flex-direction: column;
      align-items: stretch;
      mask-image: none;
    }

    .column {
      width: auto;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-active]) .deal {
      animation: deal-in 0.6s var(--ease-out-expo) both;
      animation-delay: calc(var(--d) + 120ms);
    }
  }

  @keyframes deal-in {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>
