---
import Icon from "@/components/ui/Icon.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import type { Tone } from "@/config/site";
import { solutionCopy, type SolutionTemplate } from "@/config/solutions";
import { softTone } from "@/lib/tones";

interface Props {
  tone: Tone;
  title: string;
  accent: string;
  items: SolutionTemplate[];
}

const { tone, title, accent, items } = Astro.props;
---

<section id="templates" class="ruled section pb-0" aria-labelledby="templates-title">
  <div class="shell">
    <SectionHead id="templates-title" eyebrow={{ label: solutionCopy.templatesEyebrow, icon: "layout-grid", tone }} title={title} accent={accent} />
  </div>

  <ul class="templates frame mt-12 grid sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
    {
      items.map((item) => (
        <li class="reveal flex flex-col px-(--gutter) py-8 sm:px-8 sm:py-9">
          <div class="preview" aria-hidden="true">
            <div class="mini">
              <p class="flex items-center gap-2 border-b border-line px-3 py-2">
                <span class:list={["grid size-5 shrink-0 place-items-center rounded-md", softTone[item.tone]]}>
                  <Icon name={item.icon} class="size-3" stroke={2.2} />
                </span>
                <span class="truncate text-[0.8125rem] font-semibold">{item.title}</span>
                <span class="ml-auto inline-flex shrink-0 items-center gap-1 text-[0.6875rem] font-medium text-muted">
                  <Icon name={item.layout === "Board" ? "kanban" : "table-2"} class="size-3" stroke={2} />
                  {item.object}
                </span>
              </p>
              <ul class="flex flex-wrap gap-1.5 p-3">
                {item.fields.map((field) => (
                  <li class="field">
                    <Icon name={field.icon} class:list={["size-3", field.icon === "sparkles" ? "text-violet" : "text-muted"]} stroke={2.1} />
                    {field.label}
                  </li>
                ))}
              </ul>
            </div>
          </div>
          <h3 class="mt-6 text-[1.0625rem] font-semibold tracking-[-0.02em]">{item.title}</h3>
          <p class="mt-1 text-[0.9375rem] text-muted">{item.body}</p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .templates {
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .templates > li {
    box-shadow:
      1px 0 0 var(--line),
      0 1px 0 var(--line);
  }

  .preview {
    display: grid;
    place-items: center;
    min-height: 8rem;
    padding: 1rem;
    border-radius: 0.875rem;
    background-color: var(--wash);
    background-image: radial-gradient(circle at 1px 1px, rgb(12 12 14 / 0.08) 1px, transparent 0);
    background-size: 14px 14px;
  }

  @media (min-width: 40rem) {
    .preview {
      min-height: 9.5rem;
      padding: 1.25rem;
    }
  }

  .mini {
    width: 100%;
    max-width: 19rem;
    overflow: hidden;
    border-radius: 0.75rem;
    background: var(--surface);
    box-shadow:
      0 0 0 1px rgb(12 12 14 / 0.05),
      var(--shadow-float);
  }

  .field {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    border-radius: 0.4rem;
    padding: 0.1rem 0.45rem 0.1rem 0.35rem;
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.35rem;
    white-space: nowrap;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  @media (prefers-reduced-motion: no-preference) {
    .templates > li:hover .mini {
      transform: translateY(-2px);
    }

    .mini {
      transition: transform 0.4s var(--ease-out-expo);
    }
  }
</style>
