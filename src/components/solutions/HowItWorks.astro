---
import CompanyMark from "@/components/app/CompanyMark.astro";
import Pill from "@/components/app/Pill.astro";
import Avatar from "@/components/ui/Avatar.astro";
import Icon from "@/components/ui/Icon.astro";
import SectionHead from "@/components/ui/SectionHead.astro";
import type { Tone } from "@/config/site";
import { solutionCopy, type SolutionPage } from "@/config/solutions";
import { softTone } from "@/lib/tones";

interface Props {
  tone: Tone;
  how: SolutionPage["how"];
}

const { tone, how } = Astro.props;
const { record, ask } = how;
---

<section class="ruled section pb-0" aria-labelledby="how-title">
  <div class="shell">
    <SectionHead id="how-title" eyebrow={{ label: solutionCopy.howEyebrow, icon: "zap", tone }} title={how.title} accent={how.accent} />
  </div>

  <div class="split frame mt-12 grid lg:mt-16 lg:grid-cols-12">
    <ol class="steps flex flex-col lg:col-span-5">
      {
        how.steps.map((step, index) => (
          <li class="reveal flex gap-4 px-(--gutter) py-8 sm:px-8 lg:flex-1">
            <span class:list={["grid size-9 shrink-0 place-items-center rounded-lg", softTone[tone]]}>
              <Icon name={step.icon} class="size-4" stroke={2} />
            </span>
            <span>
              <span class="mono-label block">Step {index + 1}</span>
              <h3 class="mt-1.5 text-[1.0625rem] font-semibold tracking-[-0.02em]">{step.title}</h3>
              <p class="mt-1 text-[0.9375rem] text-muted">{step.body}</p>
            </span>
          </li>
        ))
      }
    </ol>

    <div class="visual reveal lg:col-span-7" aria-hidden="true">
      <div class="w-full max-w-[25rem] sm:-translate-x-6">
        <div class="overflow-hidden rounded-xl bg-surface shadow-(--shadow-float) ring-1 ring-black/5">
          <p class="flex items-center gap-1.5 border-b border-line px-4 py-2.5 text-[0.75rem]">
            <span class="text-muted">{record.object}</span>
            <Icon name="chevron-right" class="size-3 text-faint" />
            <span class="font-medium">{record.name}</span>
            <Icon name="star" class="ml-auto size-3.5 text-yellow" stroke={2} />
          </p>
          <div class="flex items-center gap-3 px-4 pt-4">
            <CompanyMark />
            <div class="min-w-0">
              <p class="flex flex-wrap items-center gap-2 text-[1rem] font-semibold tracking-[-0.02em]">
                {record.name}
                <Pill tone={record.status.tone} dot>
                  {record.status.label}
                </Pill>
              </p>
              <p class="truncate text-[0.75rem] text-muted">{record.meta}</p>
            </div>
          </div>
          <dl class="mt-3 grid px-4 pb-5 text-[0.8125rem]">
            {
              record.fields.map((field) => (
                <div class="flex h-8 items-center gap-2 border-t border-line first:border-t-0">
                  <dt class:list={["flex w-28 shrink-0 items-center gap-1.5", field.ai ? "text-violet-ink" : "text-muted"]}>
                    <Icon name={field.icon} class="size-3.5" />
                    {field.label}
                  </dt>
                  <dd class:list={["flex min-w-0 items-center gap-1.5 font-medium", field.ai && "text-violet-ink"]}>
                    {field.avatar && <Avatar name={field.value} class="size-4" />}
                    {field.tone ? (
                      <Pill tone={field.tone} dot>
                        {field.value}
                      </Pill>
                    ) : (
                      <span class="truncate">{field.value}</span>
                    )}
                  </dd>
                </div>
              ))
            }
          </dl>
        </div>

        <div class="relative -mt-3 ml-auto w-[min(100%,20rem)] rounded-xl bg-surface p-3.5 shadow-(--shadow-float) ring-1 ring-black/5 sm:translate-x-16">
          <p class="flex items-center gap-1.5 text-[0.75rem] font-semibold text-violet-ink">
            <span class="grid size-5 place-items-center rounded-md bg-violet-soft">
              <Icon name="sparkles" class="size-3" stroke={2.2} />
            </span>
            Ask Modal
          </p>
          <p class="mt-2.5 rounded-lg bg-sunken px-2.5 py-1.5 text-[0.8125rem] font-medium">{ask.question}</p>
          <p class="mt-2 text-[0.8125rem] leading-snug text-ink-soft">{ask.answer}</p>
          <p class="mt-2.5 flex flex-wrap gap-1.5">
            {
              ask.sources.map((source) => (
                <span class="inline-flex items-center gap-1 rounded-md px-1.5 text-[0.6875rem] leading-5 font-medium text-muted ring-1 ring-line">
                  <Icon name="circle-check" class="size-3 text-green" stroke={2.2} />
                  {source}
                </span>
              ))
            }
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .split {
    border-top: 1px solid var(--line);
  }

  .steps > li + li {
    border-top: 1px solid var(--line);
  }

  .visual {
    display: grid;
    place-items: center;
    min-height: 30rem;
    padding: 3rem var(--gutter);
    border-top: 1px solid var(--line);
    background: linear-gradient(180deg, var(--wash), var(--surface));
  }

  @media (min-width: 64rem) {
    .visual {
      border-top: 0;
      border-left: 1px solid var(--line);
    }
  }
</style>
