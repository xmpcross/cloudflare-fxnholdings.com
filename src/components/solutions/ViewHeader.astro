---
import Icon from "@/components/ui/Icon.astro";
import type { Tone } from "@/config/site";
import { dotTone } from "@/lib/tones";

interface Props {
  title: string;
  tone: Tone;
  count?: string;
  /** Saved views under the title bar; the first is selected. */
  views?: string[];
  /** A short label beside the title, such as "Board". */
  layout?: string;
}

const { title, tone, count, views = [], layout } = Astro.props;
---

<div class="flex h-11 items-center gap-2 border-b border-line px-4">
  <span class:list={["size-2.5 shrink-0 rounded-[3px]", dotTone[tone]]}></span>
  <span class="truncate text-[0.875rem] font-semibold tracking-[-0.01em]">{title}</span>
  {count && <span class="text-[0.8125rem] text-faint tabular">{count}</span>}
  {layout && <span class="rounded-md bg-sunken px-1.5 text-[0.75rem] font-medium text-muted">{layout}</span>}
  <span class="ml-auto hidden items-center gap-3 text-[0.8125rem] text-muted sm:flex">
    <slot />
    <span class="flex items-center gap-1.5">
      <span class="tool"><Icon name="list-filter" class="size-3.5" stroke={2} /> Filter</span>
      <span class="tool tool-dark"><Icon name="plus" class="size-3.5" stroke={2.25} /> New</span>
    </span>
  </span>
</div>
{
  views.length > 0 && (
    // Views that don't fit wrap onto a hidden second line.
    <div class="flex h-9 flex-wrap content-start items-center gap-x-1 gap-y-4 overflow-hidden border-b border-line px-3 pt-1.5 text-[0.8125rem]">
      {views.map((view, index) => (
        <span class:list={["shrink-0 rounded-md px-2 py-0.5 font-medium", index === 0 ? "bg-sunken text-ink" : "text-muted"]}>{view}</span>
      ))}
      <span class="ml-1 text-faint">
        <Icon name="plus" class="size-3.5" />
      </span>
    </div>
  )
}

<style>
  .tool {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    height: 1.75rem;
    padding: 0 0.55rem;
    border-radius: 0.45rem;
    font-weight: 500;
    color: var(--ink-soft);
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .tool-dark {
    background: var(--ink);
    color: #fff;
    box-shadow: none;
  }
</style>
