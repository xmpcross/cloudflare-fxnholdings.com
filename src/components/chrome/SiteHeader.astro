---
import { Image } from "astro:assets";
import Pill from "@/components/app/Pill.astro";
import Avatar from "@/components/ui/Avatar.astro";
import CompanyLogo from "@/components/ui/CompanyLogo.astro";
import Icon from "@/components/ui/Icon.astro";
import Wordmark from "@/components/ui/Wordmark.astro";
import { stories } from "@/config/customers";
import { navigation, siteConfig, type MenuFeature } from "@/config/site";
import { formatDate, getPosts, postHref } from "@/lib/posts";
import { softTone } from "@/lib/tones";

interface Props {
  /** Lets the page show through the bar until the page scrolls. */
  transparent?: boolean;
}

const { transparent = false } = Astro.props;
const latest = (await getPosts())[0];
const story = stories[0];
const { primary } = siteConfig.actions;
const path = Astro.url.pathname;

const isCurrent = (href: string) => !href.includes("#") && href !== "/" && path.startsWith(href);
const menus = navigation.map((item, index) => ({ ...item, id: `menu-${index}` }));
const featureOf = (item: (typeof menus)[number]): MenuFeature | undefined => ("columns" in item ? item.feature : undefined);
---

<header class="site-header fixed inset-x-0 top-0 z-50" data-header data-transparent={transparent ? "" : undefined}>
  <div class="header-bar relative z-20">
    <div class="shell flex h-(--header-h) items-center gap-4 lg:grid lg:grid-cols-[1fr_auto_auto]">
      <a href="/" class="flex shrink-0 justify-self-start" aria-label={`${siteConfig.name} home`} data-logo-menu-trigger>
        <Wordmark class="h-11" />
      </a>

      <nav class="hidden lg:block" aria-label="Main">
        <ul class="flex items-center gap-0.5">
          {
            menus.map((item) => (
              <li>
                {"columns" in item ? (
                  <button type="button" class="nav-trigger" aria-expanded="false" aria-controls={item.id} data-menu-trigger={item.id}>
                    {item.label}
                    <Icon name="chevron-down" class="nav-chevron size-3.5" stroke={2.2} />
                  </button>
                ) : (
                  <a href={item.href} class="nav-trigger" aria-current={isCurrent(item.href) ? "page" : undefined}>
                    {item.label}
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="ml-auto flex items-center gap-1.5 justify-self-end sm:gap-2">
        <a href={primary.href} class="btn btn-primary btn-sm hidden sm:inline-flex">{primary.label}</a>
        <button
          type="button"
          class="-mr-2 grid size-11 place-items-center rounded-lg transition-colors hover:bg-black/5 lg:hidden"
          aria-expanded="false"
          aria-controls="mobile-nav"
          aria-label="Open menu"
          data-mobile-toggle
        >
          <span class="grid" data-icon-open><Icon name="menu" class="size-5" /></span>
          <span class="hidden" data-icon-close><Icon name="x" class="size-5" /></span>
        </button>
      </div>
    </div>
  </div>

  {
    menus.map(
      (item) =>
        "columns" in item && (
          <div id={item.id} class="mega absolute inset-x-0 top-full z-10 hidden bg-surface lg:block" inert data-menu-panel>
            <div class="shell grid grid-cols-[1fr_1fr_22rem] gap-10 py-8">
              {item.columns.map((column, index) => (
                <div class="mega-col" style={`--i:${index}`}>
                  {column.title && <p class="mono-label px-2.5 text-[0.6875rem]">{column.title}</p>}
                  <ul class="mt-3 grid gap-0.5">
                    {column.links.map((link) =>
                      link.description ? (
                        <li>
                          <a href={link.href} class="menu-link group" data-menu-link>
                            <span class:list={["menu-icon", softTone[link.tone ?? "ink"]]}>
                              <Icon name={link.icon ?? "arrow-right"} class="size-4" stroke={2} />
                            </span>
                            <span class="min-w-0">
                              <span class="block text-[0.9375rem] leading-snug font-medium tracking-[-0.01em]">{link.label}</span>
                              <span class="block text-[0.8125rem] leading-snug text-muted">{link.description}</span>
                            </span>
                          </a>
                        </li>
                      ) : (
                        <li>
                          <a href={link.href} class="menu-plain group" data-menu-link>
                            {link.label}
                            <Icon name="arrow-right" class="btn-arrow size-3.5 text-muted opacity-0 transition-opacity group-hover:opacity-100" stroke={2} />
                          </a>
                        </li>
                      ),
                    )}
                  </ul>
                </div>
              ))}

              <div class="mega-col" style="--i:2">
                {featureOf(item) === "product" && (
                  <a href="/#product-tour" class="feature group bg-[linear-gradient(160deg,#e9efff,#f6f0ff_55%,#fff1e8)]" data-menu-link>
                    <span class="block rounded-xl bg-white p-3 shadow-(--shadow-float) ring-1 ring-black/5">
                      <span class="flex items-center gap-2">
                        <span class="text-[0.8125rem] font-semibold">Lumen Labs</span>
                        <Icon name="star" class="ml-auto size-3.5 text-yellow" stroke={2} />
                      </span>
                      <span class="mt-3 grid gap-1.5 text-[0.75rem]">
                        <span class="flex items-center justify-between">
                          <span class="text-muted">Stage</span>
                          <Pill tone="yellow" dot>
                            Negotiation
                          </Pill>
                        </span>
                        <span class="flex justify-between">
                          <span class="text-muted">ARR</span>
                          <span class="font-semibold tabular">$84,000</span>
                        </span>
                        <span class="flex items-center justify-between">
                          <span class="text-muted">Owner</span>
                          <span class="flex items-center gap-1 font-medium">
                            <Avatar name="Maya Chen" class="size-4" /> Maya Chen
                          </span>
                        </span>
                        <span class="flex justify-between">
                          <span class="flex items-center gap-1 text-violet-ink">
                            <Icon name="sparkles" class="size-3" /> Funding
                          </span>
                          <span class="font-medium text-violet-ink">Series B</span>
                        </span>
                      </span>
                    </span>
                    <span class="mt-auto block pt-4">
                      <span class="block text-[0.9375rem] font-medium tracking-[-0.01em]">Take the product tour</span>
                      <span class="mt-0.5 inline-flex items-center gap-1 text-[0.8125rem] text-muted group-hover:text-ink">
                        See {siteConfig.name} in two minutes <Icon name="arrow-right" class="btn-arrow size-3.5" stroke={2} />
                      </span>
                    </span>
                  </a>
                )}
                {featureOf(item) === "story" && story && (
                  <a href="/customers/" class="feature group bg-night text-night-ink" data-menu-link>
                    <span class="story-glow" aria-hidden="true" />
                    <CompanyLogo name={story.company} class="relative text-[1.05rem]" />
                    <span class="relative mt-auto pt-10 text-[2.75rem] leading-none font-semibold tracking-[-0.05em] tabular">{story.metric.value}</span>
                    <span class="relative mt-2 text-[0.8125rem] text-night-muted">{story.metric.label}</span>
                    <span class="relative mt-5 inline-flex items-center gap-1.5 text-[0.8125rem] font-medium">
                      Read customer stories <Icon name="arrow-right" class="btn-arrow size-3.5" stroke={2} />
                    </span>
                  </a>
                )}
                {featureOf(item) === "latest" && latest && (
                  <a href={postHref(latest)} class="feature group bg-wash p-1.5!" data-menu-link>
                    <span class="block aspect-16/10 overflow-hidden rounded-lg">
                      <Image src={latest.data.cover} alt="" width={480} height={300} class="size-full object-cover transition-transform duration-700 group-hover:scale-[1.04]" />
                    </span>
                    <span class="block p-2.5">
                      <span class="meta block text-[0.75rem]">Latest · {formatDate(latest.data.date)}</span>
                      <span class="mt-1 line-clamp-2 block text-[0.9375rem] leading-snug font-medium tracking-[-0.01em]">{latest.data.title}</span>
                    </span>
                  </a>
                )}
              </div>
            </div>

            {item.footer && (
              <div class="border-t border-line bg-wash">
                <ul class="shell flex items-center gap-1 py-2.5">
                  {item.footer.map((link) => (
                    <li>
                      <a href={link.href} class="inline-flex items-center gap-2 rounded-md px-2.5 py-1.5 text-[0.8125rem] font-medium text-muted transition-colors hover:bg-surface hover:text-ink" data-menu-link>
                        {link.icon && <Icon name={link.icon} class="size-3.5" />}
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        ),
    )
  }

  <div id="mobile-nav" class="mobile-nav fixed inset-x-0 top-0 bottom-0 z-10 overflow-y-auto bg-page lg:hidden" inert data-mobile-nav>
    <nav class="shell flex min-h-full flex-col pt-[calc(var(--header-h)+0.75rem)] pb-8" aria-label="Mobile">
      <ul class="grid gap-1">
        {
          menus.map((item) => (
            <li>
              {"columns" in item ? (
                <details class="mobile-group rounded-2xl" name="mobile-menu">
                  <summary class="flex items-center justify-between rounded-2xl px-3 py-3.5 text-xl font-semibold tracking-[-0.03em]">
                    {item.label}
                    <Icon name="chevron-down" class="mobile-chevron size-5 text-muted" stroke={2} />
                  </summary>
                  <div class="grid gap-5 px-1 pb-4">
                    {item.columns.map((column) => (
                      <div>
                        {column.title && <p class="mono-label px-2 text-[0.6875rem]">{column.title}</p>}
                        <ul class="mt-1.5 grid gap-0.5">
                          {column.links.map((link) => (
                            <li>
                              <a href={link.href} class="flex items-center gap-3 rounded-xl px-2 py-2 text-[1.0625rem] font-medium" data-menu-link>
                                {link.icon ? (
                                  <span class:list={["grid size-8 place-items-center rounded-lg", softTone[link.tone ?? "ink"]]}>
                                    <Icon name={link.icon} class="size-4" stroke={2} />
                                  </span>
                                ) : (
                                  <span class="grid size-8 place-items-center text-muted">
                                    <Icon name="arrow-right" class="size-4" />
                                  </span>
                                )}
                                {link.label}
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </details>
              ) : (
                <a href={item.href} class="block rounded-2xl px-3 py-3.5 text-xl font-semibold tracking-[-0.03em]" data-menu-link>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <div class="mt-auto grid gap-3 pt-10">
        <a href={primary.href} class="btn btn-primary btn-lg w-full">{primary.label}</a>
      </div>
    </nav>
  </div>

  <div class="menu-scrim fixed inset-0 -z-10 bg-ink/20" data-menu-scrim></div>
</header>

<style>
  .site-header {
    transition: transform 0.45s var(--ease-out-expo);
  }

  .site-header[data-hidden] {
    transform: translateY(-110%);
  }

  .header-bar {
    background: var(--page);
    box-shadow: 0 1px 0 var(--line);
    transition:
      background-color 0.3s,
      box-shadow 0.3s;
  }

  [data-transparent]:not([data-scrolled], [data-menu-open], [data-mobile-open]) .header-bar {
    background: transparent;
    box-shadow: 0 1px 0 transparent;
  }

  [data-mobile-open] .header-bar {
    background: var(--page);
    box-shadow: none;
  }

  .nav-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.45rem 0.75rem;
    border-radius: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--ink-soft);
    transition:
      color 0.2s,
      background-color 0.2s;
  }

  .nav-trigger:hover,
  .nav-trigger[aria-expanded="true"],
  .nav-trigger[aria-current="page"] {
    background: rgb(12 12 14 / 0.05);
    color: var(--ink);
  }

  .nav-chevron {
    color: var(--faint);
    transition: transform 0.3s var(--ease-out-expo);
  }

  .nav-trigger[aria-expanded="true"] .nav-chevron {
    transform: rotate(180deg);
  }

  /* Closed panels stay rendered (so they can fade) but are inert and click-through. */
  .mega {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-0.4rem);
    box-shadow:
      0 1px 0 var(--line),
      0 24px 40px -24px rgb(12 12 14 / 0.25);
    transition:
      opacity 0.18s,
      transform 0.3s var(--ease-out-expo);
  }

  .mega[data-open] {
    opacity: 1;
    pointer-events: auto;
    transform: none;
    transition:
      opacity 0.2s,
      transform 0.35s var(--ease-out-expo);
  }

  .mega-col {
    opacity: 0;
    transform: translateY(-0.25rem);
    transition:
      opacity 0.25s,
      transform 0.4s var(--ease-out-expo);
  }

  .mega[data-open] .mega-col {
    opacity: 1;
    transform: none;
    transition-delay: calc(var(--i) * 35ms + 30ms);
  }

  .menu-link {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem;
    border-radius: 0.75rem;
    transition: background-color 0.15s;
  }

  .menu-link:hover,
  .menu-link:focus-visible {
    background: var(--wash);
  }

  .menu-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.6rem;
    transition: transform 0.3s var(--ease-out-expo);
  }

  .menu-link:hover .menu-icon {
    transform: scale(1.06) rotate(-4deg);
  }

  .menu-plain {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.625rem;
    border-radius: 0.6rem;
    font-size: 0.9375rem;
    font-weight: 500;
    transition: background-color 0.15s;
  }

  .menu-plain:hover {
    background: var(--wash);
  }

  .feature {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    padding: 1rem;
    border-radius: 0.9rem;
  }

  .story-glow {
    position: absolute;
    right: -30%;
    bottom: -40%;
    width: 120%;
    aspect-ratio: 1;
    background: radial-gradient(closest-side, rgb(255 106 31 / 0.45), rgb(124 77 255 / 0.2) 55%, transparent);
  }

  .menu-scrim {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.25s,
      visibility 0s 0.25s;
  }

  [data-menu-open] .menu-scrim {
    opacity: 1;
    visibility: visible;
    transition: opacity 0.25s;
  }

  .mobile-nav {
    overscroll-behavior: contain;
    scrollbar-width: none;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.25s;
  }

  [data-mobile-open] .mobile-nav {
    opacity: 1;
    pointer-events: auto;
  }

  .mobile-nav::-webkit-scrollbar {
    display: none;
  }

  .mobile-group[open] {
    background: var(--wash);
  }

  .mobile-group summary {
    list-style: none;
    cursor: pointer;
  }

  .mobile-group summary::-webkit-details-marker {
    display: none;
  }

  .mobile-chevron {
    transition: transform 0.3s var(--ease-out-expo);
  }

  .mobile-group[open] .mobile-chevron {
    transform: rotate(180deg);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>("[data-header]");

  if (header) {
    const triggers = [...header.querySelectorAll<HTMLButtonElement>("[data-menu-trigger]")];
    const panels = [...header.querySelectorAll<HTMLElement>("[data-menu-panel]")];
    const scrim = header.querySelector<HTMLElement>("[data-menu-scrim]");
    const mobileToggle = header.querySelector<HTMLButtonElement>("[data-mobile-toggle]");
    const mobileNav = header.querySelector<HTMLElement>("[data-mobile-nav]");
    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    let current: string | null = null;
    let hoverTimer = 0;

    const setMenu = (id: string | null, focusFirst = false) => {
      current = id;
      triggers.forEach((trigger) => trigger.setAttribute("aria-expanded", String(trigger.dataset.menuTrigger === id)));
      panels.forEach((panel) => {
        panel.toggleAttribute("data-open", panel.id === id);
        panel.inert = panel.id !== id;
      });
      header.toggleAttribute("data-menu-open", id !== null);
      if (id && focusFirst) document.getElementById(id)?.querySelector<HTMLElement>("a")?.focus();
    };

    const closeMenu = (returnFocus = false) => {
      const trigger = triggers.find((item) => item.dataset.menuTrigger === current);
      setMenu(null);
      if (returnFocus) trigger?.focus();
    };

    triggers.forEach((trigger) => {
      const id = trigger.dataset.menuTrigger ?? null;
      trigger.addEventListener("click", () => setMenu(current === id ? null : id));
      trigger.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown") {
          event.preventDefault();
          setMenu(id, true);
        }
      });
      trigger.addEventListener("pointerenter", () => {
        if (!finePointer.matches) return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => setMenu(id), current ? 0 : 80);
      });
    });

    /* Leaving the bar or the open panel starts a short timer; the menu closes
       only if the pointer is in neither when it runs. */
    const bar = header.querySelector<HTMLElement>(".header-bar");
    const hoverZones = [bar, ...panels].filter((el): el is HTMLElement => el !== null);
    let pointer = { x: 0, y: 0 };
    document.addEventListener("pointermove", (event) => (pointer = { x: event.clientX, y: event.clientY }), { passive: true });
    const scheduleClose = () => {
      if (!finePointer.matches || !current) return;
      window.clearTimeout(hoverTimer);
      hoverTimer = window.setTimeout(() => {
        const inside = hoverZones.some((zone) => {
          if (zone !== bar && zone.id !== current) return false;
          const box = zone.getBoundingClientRect();
          return pointer.x >= box.left && pointer.x <= box.right && pointer.y >= box.top && pointer.y <= box.bottom;
        });
        if (!inside) closeMenu();
      }, 200);
    };
    hoverZones.forEach((zone) => {
      zone.addEventListener("pointerleave", scheduleClose);
      zone.addEventListener("pointerenter", () => {
        if (current) window.clearTimeout(hoverTimer);
      });
    });

    bar?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
      link.addEventListener("pointerenter", () => {
        if (!finePointer.matches || !current) return;
        window.clearTimeout(hoverTimer);
        hoverTimer = window.setTimeout(() => closeMenu(), 90);
      });
      link.addEventListener("focus", () => {
        if (current) closeMenu();
      });
    });

    scrim?.addEventListener("click", () => closeMenu());

    header.addEventListener("focusout", (event) => {
      const next = event.relatedTarget as Node | null;
      if (current && next && !header.contains(next)) closeMenu();
    });

    const setMobile = (open: boolean) => {
      header.toggleAttribute("data-mobile-open", open);
      if (mobileNav) mobileNav.inert = !open;
      mobileToggle?.setAttribute("aria-expanded", String(open));
      mobileToggle?.setAttribute("aria-label", open ? "Close menu" : "Open menu");
      mobileToggle?.querySelector("[data-icon-open]")?.classList.toggle("hidden", open);
      mobileToggle?.querySelector("[data-icon-close]")?.classList.toggle("hidden", !open);
      document.documentElement.style.overflow = open ? "hidden" : "";
    };

    mobileToggle?.addEventListener("click", () => setMobile(!header.hasAttribute("data-mobile-open")));

    header.querySelectorAll("[data-menu-link]").forEach((link) =>
      link.addEventListener("click", () => {
        closeMenu();
        setMobile(false);
      }),
    );

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape") return;
      if (current) closeMenu(true);
      if (header.hasAttribute("data-mobile-open")) {
        setMobile(false);
        mobileToggle?.focus();
      }
    });

    window.matchMedia("(min-width: 64rem)").addEventListener("change", (event) => {
      if (event.matches) setMobile(false);
      else closeMenu();
    });

    /* Hide while scrolling down, return on any scroll up. Never hides near the
       top, or while a menu or the mobile sheet is open. */
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      const busy = current !== null || header.hasAttribute("data-mobile-open") || header.contains(document.activeElement);
      header.toggleAttribute("data-scrolled", y > 8);
      if (y < 160 || busy) header.removeAttribute("data-hidden");
      else if (Math.abs(y - lastY) > 6) header.toggleAttribute("data-hidden", y > lastY);
      lastY = y;
      document.documentElement.toggleAttribute("data-header-hidden", header.hasAttribute("data-hidden"));
    };
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
    header.addEventListener("focusin", () => header.removeAttribute("data-hidden"));
  }
</script>
