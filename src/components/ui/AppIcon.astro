---
import { integration } from "@/config/integrations";

interface Props {
  /** A file name in `src/assets/integrations`, without `.svg`. */
  name: string;
  class?: string;
  /** Draws the tile without its border and background. */
  bare?: boolean;
}

const files = import.meta.glob<string>("/src/assets/integrations/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const { name, class: className = "size-9", bare = false } = Astro.props;
const raw = files[`/src/assets/integrations/${name}.svg`] ?? "";
const svg = raw
  .replace(/<title>[\s\S]*?<\/title>/, "")
  .replace(/<svg([^>]*)>/, (_, attrs: string) => `<svg${attrs.replace(/\s(width|height|role)="[^"]*"/g, "")} fill="currentColor" aria-hidden="true">`);
const color = integration(name)?.color ?? "currentColor";
---

<span
  class:list={["app-icon grid shrink-0 place-items-center", !bare && "rounded-[28%] bg-surface shadow-[inset_0_0_0_1px_var(--line)]", className]}
  style={`color:${color}`}
  aria-hidden="true"
>
  <span class="block size-[52%] [&>svg]:size-full" set:html={svg} />
</span>
