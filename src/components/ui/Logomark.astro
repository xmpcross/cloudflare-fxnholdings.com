---
import mark from "@/assets/brand/logomark.svg?raw";

interface Props {
  class?: string;
}

const { class: className = "size-8" } = Astro.props;
---

<span class:list={["grid shrink-0 place-items-center rounded-[8px] bg-ink text-white", className]} aria-hidden="true">
  <span class="h-[54%] [&>svg]:h-full [&>svg]:w-auto" set:html={mark} />
</span>
