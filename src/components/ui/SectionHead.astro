---
import Icon from "@/components/ui/Icon.astro";
import type { Eyebrow } from "@/config/home";
import { softTone } from "@/lib/tones";

interface Props {
  title: string;
  /** Muted text that runs on from the title, in the same heading. */
  accent?: string;
  /** A paragraph under the heading. */
  lead?: string;
  eyebrow?: Eyebrow;
  align?: "center" | "start";
  size?: "lg" | "md";
  /** Heading id, for `aria-labelledby` on the section. */
  id?: string;
  class?: string;
}

const { title, accent, lead, eyebrow, align = "start", size = "lg", id, class: className } = Astro.props;
---

<div class:list={["reveal", align === "center" ? "mx-auto max-w-3xl text-center" : "max-w-3xl", className]}>
  {
    eyebrow && (
      <p class:list={["eyebrow mb-5", softTone[eyebrow.tone]]}>
        <Icon name={eyebrow.icon} class="size-3.5" stroke={2.1} />
        {eyebrow.label}
      </p>
    )
  }
  <h2 id={id} class:list={[size === "lg" ? "text-[clamp(1.85rem,1.35rem+1.7vw,2.65rem)] leading-[1.08]" : "text-display-md", "tracking-[-0.045em]"]}>
    {title}
    {accent && <span class="text-muted"> {accent}</span>}
  </h2>
  {lead && <p class:list={["mt-5 text-lead text-muted", align === "center" && "mx-auto max-w-2xl"]}>{lead}</p>}
  <slot />
</div>
