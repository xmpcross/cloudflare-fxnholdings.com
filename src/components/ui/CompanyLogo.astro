---
import type { CompanyName } from "@/config/customers";

interface Props {
  name: CompanyName;
  class?: string;
}

/* Fictional logos, one SVG per company in src/assets/logos, named after the company in lowercase. */
const files = import.meta.glob<string>("/src/assets/logos/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});

const { name, class: className } = Astro.props;
const svg = (files[`/src/assets/logos/${name.toLowerCase()}.svg`] ?? "").replace(
  "<svg ",
  '<svg aria-hidden="true" ',
);
---

<span class:list={["company-logo inline-flex shrink-0 items-center", className]} role="img" aria-label={name} set:html={svg} />

<style>
  .company-logo :global(svg) {
    display: block;
    height: 1.5em;
    width: auto;
  }
</style>
