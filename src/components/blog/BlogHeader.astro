---
import TopicNav from "@/components/blog/TopicNav.astro";
import Icon from "@/components/ui/Icon.astro";

interface Props {
  title: string;
  description: string;
  topic?: string;
}

const { title, description, topic } = Astro.props;
---

<header class="pt-14 pb-10 sm:pt-20 lg:pb-12">
  <div class="shell">
    <div class="flex flex-wrap items-end justify-between gap-x-10 gap-y-6">
      <div class="max-w-2xl">
        <p class="rise eyebrow mb-5 bg-blue-soft text-blue-ink">
          <Icon name="newspaper" class="size-3.5" stroke={2.1} />
          {topic ? "Topic" : "Blog"}
        </p>
        <h1 class="rise text-display-xl" style={`--i:1;${!topic ? "font-size:4rem;" : ""}`}>{title}</h1>
        <p class="rise mt-5 text-lead text-muted" style="--i:2">{description}</p>
      </div>
      <button
        type="button"
        class="rise flex h-11 w-full max-w-xs items-center gap-3 rounded-xl bg-surface px-3.5 text-[0.9375rem] text-muted shadow-[inset_0_0_0_1px_var(--line-strong),0_1px_2px_rgb(12_12_14/0.04)] transition-colors hover:text-ink"
        style="--i:3"
        data-search-open
      >
        <Icon name="search" class="size-4" />
        <span class="flex-1 text-left">Search posts</span>
        <kbd class="rounded-md bg-wash px-1.5 py-0.5 font-mono text-[0.6875rem] font-medium shadow-[inset_0_0_0_1px_var(--line)]">⌘K</kbd>
      </button>
    </div>
    <div class="rise mt-10" style="--i:4">
      <TopicNav current={topic} />
    </div>
  </div>
</header>
