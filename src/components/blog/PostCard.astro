---
import { Image } from "astro:assets";
import Pill from "@/components/app/Pill.astro";
import { formatDate, postHref, type Post } from "@/lib/posts";
import { topicTone } from "@/lib/topics";

interface Props {
  post: Post;
  variant?: "card" | "lead";
  headingLevel?: "h2" | "h3";
  eager?: boolean;
}

const { post, variant = "card", headingLevel = "h3", eager = false } = Astro.props;
const { title, description, cover, coverAlt, topic, date, author } = post.data;
const Heading = headingLevel;
const lead = variant === "lead";
---

<article
  class:list={[
    "post-card group relative flex h-full flex-col",
    lead && "gap-8 overflow-hidden rounded-[1.25rem] bg-wash p-2 ring-1 ring-line lg:grid lg:grid-cols-12 lg:items-center lg:gap-10",
  ]}
>
  <div class:list={["overflow-hidden bg-sunken ring-1 ring-black/5", lead ? "aspect-16/10 rounded-2xl lg:col-span-7" : "aspect-16/10 rounded-xl"]}>
    <Image
      src={cover}
      alt={coverAlt}
      widths={lead ? [640, 960, 1400] : [480, 720, 960]}
      sizes={lead ? "(min-width: 1024px) 44rem, 100vw" : "(min-width: 1024px) 24rem, (min-width: 640px) 50vw, 100vw"}
      loading={eager ? "eager" : "lazy"}
      fetchpriority={eager && lead ? "high" : undefined}
      class="post-cover size-full object-cover"
    />
  </div>
  <div class:list={["flex flex-1 flex-col", lead ? "px-4 pb-6 lg:col-span-5 lg:px-0 lg:pr-8 lg:pb-0" : "pt-5"]}>
    <p class="meta flex flex-wrap items-center gap-x-2.5">
      <Pill tone={topicTone(topic)} dot>
        {topic}
      </Pill>
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
    </p>
    <Heading class:list={["mt-3", lead ? "text-display-md" : "text-xl leading-snug font-semibold tracking-[-0.025em]"]}>
      <a href={postHref(post)} class="post-link after:absolute after:inset-0">{title}</a>
    </Heading>
    <p class:list={["mt-3 text-muted", lead ? "text-lead" : "line-clamp-2"]}>{description}</p>
    {lead && <p class="mt-6 text-sm font-medium">By {author}</p>}
  </div>
</article>

<style>
  .post-cover {
    transition: transform 0.8s var(--ease-out-expo);
  }

  .post-card:hover .post-cover {
    transform: scale(1.03);
  }

  .post-link {
    background-image: linear-gradient(currentColor, currentColor);
    background-size: 0 1.5px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    transition: background-size 0.4s var(--ease-out-expo);
  }

  .post-card:hover .post-link {
    background-size: 100% 1.5px;
  }

  .post-card:has(a:focus-visible) {
    outline: 2px solid var(--blue);
    outline-offset: 6px;
    border-radius: 1rem;
  }

  .post-card a:focus-visible {
    outline: none;
  }
</style>
