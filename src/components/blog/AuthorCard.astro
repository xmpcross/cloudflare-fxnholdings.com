---
import { Image } from "astro:assets";
import Logomark from "@/components/ui/Logomark.astro";
import { authorOf } from "@/lib/posts";

interface Props {
  names: string[];
}

const { names } = Astro.props;
---

<section
  class:list={["mt-6 grid gap-4", names.length > 1 && "sm:grid-cols-2"]}
  aria-label={names.length > 1 ? "About the authors" : "About the author"}
>
  {
    names.map((name, i) => {
      const author = authorOf(name);
      return (
        <div class="flex items-start gap-4 rounded-[8px] bg-wash p-5 sm:p-6">
          {author?.photo ? (
            <Image
              src={author.photo}
              alt={`Portrait of ${name}`}
              widths={[136, 204]}
              sizes="4.25rem"
              class="size-17 shrink-0 rounded-[8px] object-cover object-top"
            />
          ) : author?.initials ? (
            <span class="grid size-14 shrink-0 place-items-center rounded-[8px] bg-blue-soft text-lg font-semibold text-blue-ink" aria-hidden="true">{author.initials}</span>
          ) : (
            <Logomark class="size-17" />
          )}
          <div class="min-w-0 leading-tight">
            <p class="meta">{i === 0 ? "Written by" : "Co-author"}</p>
            <p class="mt-1.5 text-lg font-semibold tracking-[-0.02em]">{name}</p>
            {author?.role && <p class="mt-1 text-sm text-muted">{author.role}</p>}
            {author?.bio && <p class="mt-3 text-sm leading-relaxed text-muted">{author.bio}</p>}
            {author?.profileUrl && <a href={author.profileUrl} class="mt-3 inline-block text-sm font-medium text-blue-ink underline underline-offset-4">View LinkedIn profile</a>}
          </div>
        </div>
      );
    })
  }
</section>
