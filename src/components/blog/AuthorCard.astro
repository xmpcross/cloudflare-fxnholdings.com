---
import { Image } from "astro:assets";
import Logomark from "@/components/ui/Logomark.astro";
import { authorOf } from "@/lib/posts";

interface Props {
  names: string[];
}

const { names } = Astro.props;
---

<section
  class="mt-6 grid gap-2 sm:grid-cols-2"
  aria-label={names.length > 1 ? "About the authors" : "About the author"}
>
  {
    names.map((name, i) => {
      const author = authorOf(name);
      return (
        <div class="flex items-center gap-4 rounded-[1.125rem] bg-wash p-3 pr-5 ring-1 ring-line">
          {author?.photo ? (
            <Image
              src={author.photo}
              alt={`Portrait of ${name}`}
              widths={[136, 204]}
              sizes="4.25rem"
              class="size-17 shrink-0 rounded-xl object-cover object-top"
            />
          ) : (
            <Logomark class="size-17" />
          )}
          <div class="min-w-0 leading-tight">
            <p class="meta">{i === 0 ? "Written by" : "Co-author"}</p>
            <p class="mt-1.5 truncate text-lg font-semibold tracking-[-0.02em]">{name}</p>
            {author?.role && <p class="mt-1 truncate text-sm text-muted">{author.role}</p>}
          </div>
        </div>
      );
    })
  }
</section>
