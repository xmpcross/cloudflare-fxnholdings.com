---
import Avatar from "@/components/ui/Avatar.astro";
import Icon from "@/components/ui/Icon.astro";

const kpis = [
  { label: "Open pipeline", icon: "target", value: "$ 1.24M", delta: "18%", up: true },
  { label: "Closed won", icon: "badge-check", value: "$ 412K", delta: "14%", up: true },
  { label: "Churned", icon: "trending-down", value: "$ 38K", delta: "6%", up: false },
  { label: "Net new ARR", icon: "coins", value: "$ 374K", delta: "9%", up: true },
];

/* Monthly values in $k. */
const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
const created = [62, 150, 232, 176, 40, 96, 158, 104, 82, 92, 190, 226];
const won = [108, 52, 30, 44, 62, 50, 118, 132, 58, 96, 86, 40];
const marked = [1, 3, 6, 10];
const focus = 6;

const width = 720;
const height = 170;
const max = 250;
const step = width / (months.length - 1);
const point = (values: number[], i: number) => [i * step, height - (values[i] / max) * height] as const;

/* A Catmull-Rom spline through every point, drawn as cubic Béziers. */
function curve(values: number[]) {
  const pts = values.map((_, i) => point(values, i));
  let d = `M${pts[0][0]},${pts[0][1]}`;
  for (let i = 0; i < pts.length - 1; i++) {
    const [p0, p1, p2, p3] = [pts[i - 1] ?? pts[i], pts[i], pts[i + 1], pts[i + 2] ?? pts[i + 1]];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += ` C${c1.join(",")} ${c2.join(",")} ${p2.join(",")}`;
  }
  return d;
}

const createdPath = curve(created);
const [focusX] = point(created, focus);

const deals = [
  { stage: "Lead in", person: "Ava Lindqvist", company: "Lumen Labs", value: "$ 84,000", priority: "High", tone: "bg-pink" },
  { stage: "Demo booked", person: "Tom Reyes", company: "Copperline", value: "$ 36,500", priority: "Medium", tone: "bg-orange" },
  { stage: "Negotiation", person: "Jonas Weber", company: "Aster Health", value: "$ 58,200", priority: "Low", tone: "bg-green" },
];
---

<div class="dash flex min-w-0 flex-1 flex-col overflow-hidden">
  <div class="flex shrink-0 items-center gap-3 px-5 pt-4">
    <div class="leading-tight">
      <p class="text-[0.875rem] font-semibold tracking-[-0.01em]">Dashboard</p>
      <p class="mt-0.5 text-[0.75rem] text-muted">Keep track of your pipeline and revenue</p>
    </div>
    <span class="ml-auto hidden text-[0.75rem] font-medium sm:inline">Invite team</span>
    <span class="shrink-0 rounded-lg bg-ink px-3 py-1.5 text-[0.75rem] font-medium whitespace-nowrap text-white">New deal</span>
  </div>

  <dl class="kpis mx-5 mt-4 grid shrink-0 grid-cols-2 overflow-hidden rounded-xl ring-1 ring-line">
    {
      kpis.map((kpi) => (
        <div class="kpi">
          <Icon name={kpi.icon} class="size-4 text-muted" />
          <dt class="kpi-label text-[0.75rem] text-muted">{kpi.label}</dt>
          <dd class="mt-0.5 flex flex-wrap items-baseline gap-x-1">
            <span class="kpi-value font-semibold tracking-[-0.03em] whitespace-nowrap tabular">{kpi.value}</span>
            <span class:list={["inline-flex items-center text-[0.6875rem] font-medium tabular", kpi.up ? "text-green-ink" : "text-pink-ink"]}>
              {kpi.up ? "+" : "−"}
              {kpi.delta}
              <Icon name={kpi.up ? "arrow-up-right" : "arrow-down-right"} class="size-3" stroke={2} />
            </span>
          </dd>
        </div>
      ))
    }
  </dl>

  <div class="mx-5 mt-5 shrink-0">
    <div class="flex flex-wrap items-end gap-x-4 gap-y-2">
      <div>
        <p class="text-[0.75rem] text-muted">Pipeline created</p>
        <p class="mt-0.5 flex items-baseline gap-1.5">
          <span class="text-[1.375rem] font-semibold tracking-[-0.03em] tabular">$ 1.61M</span>
          <span class="text-[0.6875rem] text-muted tabular">+24%</span>
        </p>
      </div>
      <ul class="flex gap-4 pb-1 text-[0.6875rem] text-ink-soft">
        <li class="flex items-center gap-1.5"><span class="size-2 rounded-[2px] bg-green"></span>Created</li>
        <li class="flex items-center gap-1.5"><span class="size-2 rounded-[2px] bg-orange"></span>Closed won</li>
      </ul>
      <span class="ml-auto hidden gap-0.5 rounded-lg bg-wash p-0.5 text-[0.6875rem] font-medium text-muted ring-1 ring-line sm:flex">
        <span class="rounded-md bg-surface px-2 py-0.5 text-ink shadow-[0_1px_2px_rgb(12_12_14/0.08)]">Year</span>
        <span class="px-2 py-0.5">Month</span>
        <span class="px-2 py-0.5">Week</span>
        <span class="px-2 py-0.5">Day</span>
      </span>
    </div>

    <div class="relative mt-3 pl-10">
      <div class="plot-h absolute top-0 left-0 flex flex-col justify-between text-[0.625rem] leading-none text-faint tabular">
        <span class="-translate-y-1/2">250k</span><span>150k</span><span>50k</span><span class="translate-y-1/2">0k</span>
      </div>
      <div class="plot plot-h relative">
        <svg viewBox={`0 0 ${width} ${height}`} preserveAspectRatio="none" class="absolute inset-0 size-full overflow-visible" role="presentation">
          <defs>
            <linearGradient id="dash-fill" x1="0" x2="0" y1="0" y2="1">
              <stop offset="0" stop-color="var(--green)" stop-opacity="0.1"></stop>
              <stop offset="1" stop-color="var(--green)" stop-opacity="0"></stop>
            </linearGradient>
          </defs>
          {[0, 1, 2, 3].map((i) => <line x1="0" x2={width} y1={(height / 3) * i} y2={(height / 3) * i} stroke="var(--line)" vector-effect="non-scaling-stroke" />)}
          <line x1={focusX} x2={focusX} y1="0" y2={height} stroke="var(--line-strong)" stroke-dasharray="3 3" vector-effect="non-scaling-stroke" />
          <path d={`${createdPath} L${width},${height} L0,${height} Z`} fill="url(#dash-fill)" />
          <path class="line" d={curve(won)} pathLength="1" fill="none" stroke="var(--orange)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
          <path class="line" d={createdPath} pathLength="1" fill="none" stroke="var(--green)" stroke-width="1.5" vector-effect="non-scaling-stroke" />
        </svg>
        {
          marked.map((i) => {
            const [x, y] = point(created, i);
            return <span class="marker" style={`left:${(x / width) * 100}%;top:${(y / height) * 100}%`} />;
          })
        }
        <div class="tip absolute top-1 rounded-lg bg-surface/90 px-2.5 py-1.5 shadow-(--shadow-float) ring-1 ring-black/5 backdrop-blur-sm" style={`--x:${(focusX / width) * 100}%`}>
          <p class="flex items-baseline gap-1.5 whitespace-nowrap">
            <span class="text-[0.9375rem] font-semibold tracking-[-0.02em] tabular">$ 146.8K</span>
            <span class="text-[0.625rem] text-green-ink tabular">+14%</span>
          </p>
          <p class="font-mono text-[0.5625rem] tracking-[0.04em] whitespace-nowrap text-muted uppercase">Jul 24, 2026</p>
        </div>
      </div>
      <div class="mt-2 flex justify-between text-[0.625rem] text-faint uppercase">
        {months.map((month) => <span class="month flex w-0 justify-center whitespace-nowrap first:justify-start last:justify-end">{month}</span>)}
      </div>
    </div>
  </div>

  <div class="deals mx-5 mt-5">
    <div class="flex items-center gap-3 text-[0.75rem]">
      <span class="font-semibold">Deals</span>
      <span class="ml-auto hidden items-center gap-1.5 text-faint sm:flex"><Icon name="search" class="size-3.5" /> Search</span>
      <span class="flex items-center gap-1.5 font-medium"><Icon name="sliders-horizontal" class="size-3.5" /> Filters</span>
    </div>
    <ul class="deal-grid mt-2.5 grid gap-3">
      {
        deals.map((deal, index) => (
          <li class="deal rounded-xl bg-wash p-1 ring-1 ring-line" style={`--d:${index * 80}ms`}>
            <p class="flex items-center justify-between px-2 py-1 text-[0.6875rem] text-ink-soft">
              {deal.stage}
              <Icon name="ellipsis-vertical" class="size-3.5 text-faint" />
            </p>
            <div class="rounded-lg bg-surface p-2.5 ring-1 ring-line">
              <p class="flex items-center gap-2">
                <Avatar name={deal.person} class="size-7" />
                <span class="leading-tight">
                  <span class="block text-[0.75rem] font-semibold">{deal.person}</span>
                  <span class="block text-[0.6875rem] text-muted">{deal.company}</span>
                </span>
              </p>
              <p class="mt-2.5 flex items-center gap-2">
                <span class="text-[0.875rem] font-semibold tracking-[-0.02em] tabular">{deal.value}</span>
                <span class="inline-flex items-center gap-1 text-[0.6875rem] text-muted">
                  <span class:list={["size-1.5 rounded-[1px]", deal.tone]} />
                  {deal.priority}
                </span>
              </p>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .dash {
    container-type: inline-size;
  }

  .kpi {
    padding: 0.75rem;
  }

  .kpi-label {
    margin-top: 0.5rem;
  }

  .kpi + .kpi {
    box-shadow: -1px 0 0 var(--line);
  }

  .kpi:nth-child(n + 3) {
    box-shadow:
      0 -1px 0 var(--line),
      -1px 0 0 var(--line);
  }

  .kpi-value {
    font-size: 1.125rem;
  }

  .deal-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .deal:nth-child(3) {
    display: none;
  }

  .plot-h {
    height: 7.5rem;
  }

  .tip {
    right: calc(100% - var(--x) + 0.6rem);
  }

  /* Hidden, not removed, so the rest keep their place along the axis. */
  .month:nth-child(even) {
    visibility: hidden;
  }

  @container (min-width: 32rem) {
    .month:nth-child(even) {
      visibility: visible;
    }

    .kpis {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .kpi {
      padding: 0.875rem;
    }

    .kpi-label {
      margin-top: 0.75rem;
    }

    .kpi:nth-child(n + 3) {
      box-shadow: -1px 0 0 var(--line);
    }

    .plot-h {
      height: 10rem;
    }

    .tip {
      right: auto;
      left: calc(var(--x) + 0.6rem);
    }
  }

  @container (min-width: 44rem) {
    .kpi-value {
      font-size: 1.375rem;
    }
  }

  @container (min-width: 40rem) {
    .deal-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .deal:nth-child(3) {
      display: block;
    }
  }

  .marker {
    position: absolute;
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: var(--green);
    box-shadow: 0 0 0 2px var(--surface);
    transform: translate(-50%, -50%);
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-active]) .line {
      stroke-dasharray: 1;
      animation: draw 1.6s var(--ease-out-expo) 0.15s both;
    }

    :global([data-active]) .marker,
    :global([data-active]) .tip {
      animation: pop 0.5s var(--ease-out-expo) 0.9s both;
    }

    :global([data-active]) .deal {
      animation: pop 0.6s var(--ease-out-expo) both;
      animation-delay: calc(var(--d) + 300ms);
    }
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes pop {
    from {
      opacity: 0;
      translate: 0 4px;
    }
  }
</style>
