---
import Avatar from "@/components/ui/Avatar.astro";
import Icon from "@/components/ui/Icon.astro";

const kpis = [
  { label: "Open pipeline", icon: "target", value: "$ 1.24M", delta: "+18%" },
  { label: "Win rate", icon: "percent", value: "31%", delta: "+4 pts" },
  { label: "Sales cycle", icon: "timer", value: "24 days", delta: "−3 days" },
  { label: "New deals", icon: "handshake", value: "86", delta: "+12" },
];

/* Pipeline created per month in $k, by source. */
const months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep"];
const series = [
  { name: "Inbound", color: "var(--green)", values: [62, 70, 66, 84, 92, 88, 104, 118, 126] },
  { name: "Outbound", color: "var(--orange)", values: [38, 34, 46, 44, 52, 60, 58, 66, 72] },
  { name: "Partners", color: "var(--line-strong)", values: [12, 18, 16, 22, 20, 30, 34, 32, 44] },
];
const max = 260;
const width = 520;
const height = 180;
const band = width / months.length;
const bar = band * 0.56;

const reps = [
  { name: "Maya Chen", value: "$412k", quota: 92 },
  { name: "Sam Okafor", value: "$368k", quota: 81 },
  { name: "Priya Nair", value: "$290k", quota: 64 },
  { name: "Leo Brandt", value: "$244k", quota: 55 },
];
---

<div class="reports flex min-w-0 flex-1 flex-col">
  <div class="flex shrink-0 items-center gap-3 px-5 pt-4">
    <div class="leading-tight">
      <p class="text-[0.875rem] font-semibold tracking-[-0.01em]">Revenue overview</p>
      <p class="mt-0.5 text-[0.75rem] text-muted">Every team, this year</p>
    </div>
    <span class="ml-auto hidden text-[0.75rem] font-medium sm:inline">Share</span>
    <span class="shrink-0 rounded-lg bg-ink px-3 py-1.5 text-[0.75rem] font-medium whitespace-nowrap text-white">New report</span>
  </div>

  <div class="grid gap-4 p-5 pt-4">
    <dl class="kpis grid grid-cols-2 overflow-hidden rounded-xl ring-1 ring-line">
      {
        kpis.map((kpi) => (
          <div class="kpi p-3.5">
            <Icon name={kpi.icon} class="size-4 text-muted" />
            <dt class="mt-3 text-[0.75rem] text-muted">{kpi.label}</dt>
            <dd class="mt-0.5 flex flex-wrap items-baseline gap-x-1.5">
              <span class="kpi-value font-semibold tracking-[-0.03em] whitespace-nowrap tabular">{kpi.value}</span>
              <span class="text-[0.6875rem] font-medium text-green-ink tabular">{kpi.delta}</span>
            </dd>
          </div>
        ))
      }
    </dl>

    <div class="grid gap-3 lg:grid-cols-[1.6fr_1fr]">
      <div class="rounded-xl p-3.5 ring-1 ring-line">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
          <p class="text-[0.8125rem] font-semibold">Pipeline created</p>
          <ul class="ml-auto flex gap-3 text-[0.6875rem] text-muted">
            {
              series.map((item) => (
                <li class="flex items-center gap-1.5">
                  <span class="size-2 rounded-[2px]" style={`background:${item.color}`} />
                  {item.name}
                </li>
              ))
            }
          </ul>
        </div>
        <svg viewBox={`0 0 ${width} ${height + 18}`} class="chart mt-3 w-full" role="presentation">
          {
            [0, 1, 2, 3].map((i) => (
              <line x1="0" x2={width} y1={(height / 4) * i + 0.5} y2={(height / 4) * i + 0.5} stroke="var(--line)" stroke-dasharray={i === 0 ? undefined : "2 3"} />
            ))
          }
          <line x1="0" x2={width} y1={height - 0.5} y2={height - 0.5} stroke="var(--line-strong)" />
          {
            months.map((month, m) => {
              let y = height;
              const x = m * band + (band - bar) / 2;
              return (
                <g class="col" style={`--m:${m}`}>
                  {series.map((item, s) => {
                    const h = (item.values[m] / max) * height;
                    y -= h;
                    return <rect x={x} y={y + (s === series.length - 1 ? 0 : 1)} width={bar} height={Math.max(h - (s === series.length - 1 ? 0 : 1), 0)} rx={s === series.length - 1 ? 3 : 0} fill={item.color} />;
                  })}
                  <text x={x + bar / 2} y={height + 14} text-anchor="middle" font-size="10" fill="var(--muted)">
                    {month}
                  </text>
                </g>
              );
            })
          }
        </svg>
      </div>

      <div class="rounded-xl p-3.5 ring-1 ring-line">
        <p class="text-[0.8125rem] font-semibold">Closed won by rep</p>
        <ul class="mt-3 grid gap-3">
          {
            reps.map((rep) => (
              <li class="text-[0.8125rem]">
                <span class="flex items-center gap-2">
                  <Avatar name={rep.name} class="size-5" />
                  <span class="font-medium">{rep.name}</span>
                  <span class="ml-auto font-semibold tabular">{rep.value}</span>
                </span>
                <span class="mt-1.5 block h-1.5 overflow-hidden rounded-full bg-sunken">
                  <span class="meter block h-full rounded-full bg-ink" style={`width:${rep.quota}%`} />
                </span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .reports {
    container-type: inline-size;
  }

  .kpi + .kpi {
    box-shadow: -1px 0 0 var(--line);
  }

  .kpi:nth-child(n + 3) {
    box-shadow:
      0 -1px 0 var(--line),
      -1px 0 0 var(--line);
  }

  .kpi-value {
    font-size: 1.125rem;
  }

  @container (min-width: 32rem) {
    .kpis {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .kpi:nth-child(n + 3) {
      box-shadow: -1px 0 0 var(--line);
    }
  }

  @container (min-width: 44rem) {
    .kpi-value {
      font-size: 1.375rem;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    :global([data-active]) .col {
      transform-box: fill-box;
      transform-origin: bottom;
      animation: grow 0.8s var(--ease-out-expo) both;
      animation-delay: calc(var(--m) * 50ms + 150ms);
    }

    :global([data-active]) .meter {
      transform-origin: left;
      animation: meter 1s var(--ease-out-expo) 0.3s both;
    }
  }

  @keyframes grow {
    from {
      transform: scaleY(0.2);
      opacity: 0;
    }
  }

  @keyframes meter {
    from {
      transform: scaleX(0);
    }
  }
</style>
